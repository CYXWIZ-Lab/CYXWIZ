{
  "name": "cyxwiz-ci",
  "version": "0.1.0",
  "description": "CyxWiz - CI dependencies for the supported Engine and Server Node build",
  "dependencies": [
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "glfw-binding",
        "opengl3-binding"
      ]
    },
    "implot",
    "glfw3",
    "glad",
    "stb",
    "grpc",
    "protobuf",
    "spdlog",
    "nlohmann-json",
    "fmt",
    "sqlite3",
    "openssl",
    "pybind11",
    "catch2",
    "cpp-httplib",
    "yaml-cpp",
    "jwt-cpp",
    "nativefiledialog-extended",
    "highfive",
    {
      "name": "opencv4",
      "default-features": true
    },
    "duckdb",
    {
      "name": "arrow",
      "features": ["parquet", "csv", "json"]
    }
  ],
  "builtin-baseline": "594ad8871e1e8e45f8e626c015fd611163430207"
}
