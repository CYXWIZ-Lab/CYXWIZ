{
  "id": "mnist_mlp",
  "name": "MNIST MLP Classifier",
  "description": "End-to-end MLP for a tabular MNIST CSV (785 columns: pixel1..pixel784, class). Loads CSV, normalizes pixel values by /255, splits 80/10/10, batches with shuffle, trains a 3-layer MLP with Adam. Double-click Data Input, point it at your mnist_784.csv, click Apply, then Compile (F7) and Train (F5).",
  "category": "Training Pipeline",
  "tags": ["mnist", "digits", "classification", "training", "mlp", "csv"],
  "parameters": [
    {
      "name": "batch_size",
      "type": "int",
      "default_value": "128",
      "description": "DataLoader batch size"
    },
    {
      "name": "hidden_units",
      "type": "int",
      "default_value": "128",
      "description": "Hidden layer width"
    },
    {
      "name": "learning_rate",
      "type": "float",
      "default_value": "0.001",
      "description": "Adam learning rate"
    },
    {
      "name": "epochs",
      "type": "int",
      "default_value": "10",
      "description": "Number of training epochs"
    }
  ],
  "template": {
    "nodes": [
      {
        "id": "data_input",
        "type": "DataInput",
        "name": "Data Input",
        "pos": [0, 260],
        "params": {
          "file_type": "csv",
          "has_header": "true",
          "label_column": "class",
          "dataset_name": "mnist_784"
        }
      },
      {
        "id": "data_split",
        "type": "DataSplit",
        "name": "Train/Val/Test Split",
        "pos": [260, 260],
        "params": {
          "train_ratio": "0.8",
          "val_ratio": "0.1",
          "test_ratio": "0.1",
          "seed": "42",
          "stratified": "true"
        }
      },
      {
        "id": "data_loader",
        "type": "DataLoader",
        "name": "DataLoader",
        "pos": [520, 260],
        "params": {
          "batch_size": "$batch_size",
          "shuffle": "true",
          "drop_last": "false",
          "num_workers": "0"
        }
      },
      {
        "id": "normalize",
        "type": "Normalize",
        "name": "Normalize",
        "pos": [780, 260],
        "params": {
          "mean": "0.0",
          "std": "255.0"
        }
      },
      {
        "id": "fc1",
        "type": "Dense",
        "name": "Dense",
        "pos": [1040, 260],
        "params": {
          "units": "$hidden_units"
        }
      },
      {
        "id": "relu1",
        "type": "ReLU",
        "name": "ReLU",
        "pos": [1240, 260]
      },
      {
        "id": "fc2",
        "type": "Dense",
        "name": "Dense",
        "pos": [1420, 260],
        "params": {
          "units": "64"
        }
      },
      {
        "id": "relu2",
        "type": "ReLU",
        "name": "ReLU",
        "pos": [1620, 260]
      },
      {
        "id": "fc3",
        "type": "Dense",
        "name": "Dense",
        "pos": [1800, 260],
        "params": {
          "units": "10"
        }
      },
      {
        "id": "loss",
        "type": "CrossEntropyLoss",
        "name": "CrossEntropy",
        "pos": [2000, 320]
      },
      {
        "id": "optimizer",
        "type": "Adam",
        "name": "Adam",
        "pos": [2200, 320],
        "params": {
          "learning_rate": "$learning_rate",
          "beta1": "0.9",
          "beta2": "0.999",
          "epsilon": "1e-8",
          "epochs": "$epochs"
        }
      },
      {
        "id": "output",
        "type": "Output",
        "name": "Output",
        "pos": [2400, 320],
        "params": {
          "classes": "10"
        }
      }
    ],
    "links": [
      {"from": "data_input", "to": "data_split", "from_pin": 0, "to_pin": 0},
      {"from": "data_split", "to": "data_loader", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "normalize", "from_pin": 0, "to_pin": 0},
      {"from": "normalize", "to": "fc1", "from_pin": 0, "to_pin": 0},
      {"from": "fc1", "to": "relu1", "from_pin": 0, "to_pin": 0},
      {"from": "relu1", "to": "fc2", "from_pin": 0, "to_pin": 0},
      {"from": "fc2", "to": "relu2", "from_pin": 0, "to_pin": 0},
      {"from": "relu2", "to": "fc3", "from_pin": 0, "to_pin": 0},
      {"from": "fc3", "to": "loss", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "loss", "from_pin": 1, "to_pin": 1},
      {"from": "loss", "to": "optimizer", "from_pin": 0, "to_pin": 0},
      {"from": "optimizer", "to": "output", "from_pin": 0, "to_pin": 0}
    ]
  }
}
