{
  "id": "review_sentiment_classifier",
  "name": "Review Sentiment Classifier",
  "description": "Tells positive from negative review sentences: a word tokenizer, an embedding and a dense head. The sample is examples/datasets/review_sentences.csv: 3,000 sentences from Amazon, IMDb and Yelp reviews (UCI Sentiment Labelled Sentences), columns sentence and sentiment: press Train.",
  "category": "Training Pipeline",
  "tags": [
    "text",
    "sentiment",
    "reviews",
    "nlp",
    "classification",
    "training",
    "starter"
  ],
  "parameters": [
    {
      "name": "batch_size",
      "type": "int",
      "default_value": "64",
      "description": "Training batch size",
      "min_value": "1",
      "max_value": "512"
    },
    {
      "name": "learning_rate",
      "type": "float",
      "default_value": "0.0002",
      "description": "Adam learning rate",
      "min_value": "0.00001",
      "max_value": "0.01"
    },
    {
      "name": "epochs",
      "type": "int",
      "default_value": "8",
      "description": "Number of training epochs",
      "min_value": "1",
      "max_value": "200"
    },
    {
      "name": "max_length",
      "type": "int",
      "default_value": "48",
      "description": "Max tokens per sentence (pad/truncate); review sentences are short",
      "min_value": "32",
      "max_value": "1024"
    },
    {
      "name": "embedding_dim",
      "type": "int",
      "default_value": "64",
      "description": "Token embedding vector size",
      "min_value": "8",
      "max_value": "512"
    },
    {
      "name": "vocab_size",
      "type": "int",
      "default_value": "5000",
      "description": "Vocabulary cap; the 3,000 sentences hold about 5,000 distinct words",
      "min_value": "1000",
      "max_value": "50000"
    },
    {
      "name": "min_word_freq",
      "type": "int",
      "default_value": "2",
      "description": "Minimum document frequency for a word to enter the vocabulary",
      "min_value": "1",
      "max_value": "100"
    },
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "2",
      "description": "Sentiment classes: negative, positive",
      "min_value": "2",
      "max_value": "32"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.5",
      "description": "Dropout rate on the dense head",
      "min_value": "0.0",
      "max_value": "0.7"
    }
  ],
  "template": {
    "nodes": [
      {
        "id": "data_input",
        "type": "DataInput",
        "name": "Data Input",
        "pos": [
          0,
          300
        ],
        "params": {
          "source_type": "file",
          "file_category": "text",
          "file_path": "examples/datasets/review_sentences.csv",
          "text_column": "sentence",
          "text_label_column": "sentiment"
        }
      },
      {
        "id": "text_tokenizer",
        "type": "TextTokenizer",
        "name": "Tokenizer (word)",
        "pos": [
          250,
          300
        ],
        "params": {
          "tokenizer_type": "1",
          "max_length": "$max_length",
          "lowercase": "true",
          "max_vocab_size": "$vocab_size",
          "text_col": "sentence",
          "label_col": "sentiment",
          "min_word_freq": "$min_word_freq",
          "pad_value": "0"
        }
      },
      {
        "id": "data_split",
        "type": "DataSplit",
        "name": "Stratified Split",
        "pos": [
          1000,
          300
        ],
        "params": {
          "train_ratio": "0.8",
          "val_ratio": "0.1",
          "test_ratio": "0.1",
          "stratified": "true",
          "seed": "42"
        }
      },
      {
        "id": "data_loader",
        "type": "DataLoader",
        "name": "DataLoader",
        "pos": [
          1250,
          300
        ],
        "params": {
          "batch_size": "$batch_size",
          "epochs": "$epochs",
          "shuffle": "true",
          "seed": "42",
          "validation_freq": "1"
        }
      },
      {
        "id": "embedding",
        "type": "Embedding",
        "name": "Embedding 10k x N",
        "pos": [
          1500,
          300
        ],
        "params": {
          "num_embeddings": "$vocab_size",
          "embedding_dim": "$embedding_dim",
          "padding_idx": "0"
        }
      },
      {
        "id": "flatten",
        "type": "Flatten",
        "name": "Flatten",
        "pos": [
          1750,
          300
        ]
      },
      {
        "id": "fc1",
        "type": "Dense",
        "name": "Dense 128",
        "pos": [
          2000,
          300
        ],
        "params": {
          "units": "128"
        }
      },
      {
        "id": "relu1",
        "type": "ReLU",
        "name": "ReLU",
        "pos": [
          2250,
          300
        ]
      },
      {
        "id": "drop1",
        "type": "Dropout",
        "name": "Dropout",
        "pos": [
          2500,
          300
        ],
        "params": {
          "rate": "$dropout_rate"
        }
      },
      {
        "id": "fc_out",
        "type": "Dense",
        "name": "Dense N",
        "pos": [
          2750,
          300
        ],
        "params": {
          "units": "$num_classes"
        }
      },
      {
        "id": "loss",
        "type": "CrossEntropyLoss",
        "name": "CrossEntropy",
        "pos": [
          3000,
          300
        ]
      },
      {
        "id": "optimizer",
        "type": "Adam",
        "name": "Adam",
        "pos": [
          3250,
          300
        ],
        "params": {
          "learning_rate": "$learning_rate"
        }
      },
      {
        "id": "output",
        "type": "Output",
        "name": "Output",
        "pos": [
          3500,
          300
        ],
        "params": {
          "num_classes": "$num_classes"
        }
      }
    ],
    "links": [
      {
        "from": "data_input",
        "to": "text_tokenizer",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "text_tokenizer",
        "to": "data_split",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "data_split",
        "to": "data_loader",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "data_loader",
        "to": "embedding",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "embedding",
        "to": "flatten",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "flatten",
        "to": "fc1",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "fc1",
        "to": "relu1",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "relu1",
        "to": "drop1",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "drop1",
        "to": "fc_out",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "fc_out",
        "to": "loss",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "data_loader",
        "to": "loss",
        "from_pin": 1,
        "to_pin": 1
      },
      {
        "from": "loss",
        "to": "optimizer",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "optimizer",
        "to": "output",
        "from_pin": 0,
        "to_pin": 0
      }
    ]
  }
}
