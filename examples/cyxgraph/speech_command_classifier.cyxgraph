{
  "id": "speech_command_classifier",
  "name": "Speech Command Classifier",
  "description": "Classifies short spoken words from their mel spectrogram with a dense network; a BatchNorm after Flatten scales each mel feature, without which it learns very slowly. The sample is examples/datasets/spoken_digits: the digits 0-9 spoken by four speakers (400 clips), one folder per digit (Free Spoken Digit Dataset), 8 kHz: press Train. Point Data Input at any folder of class folders of clips (for example Speech Commands, 16 kHz) and set num_classes and the sample rate.",
  "category": "Training Pipeline",
  "tags": ["speech", "audio", "keyword", "classification", "spectrogram", "training"],
  "parameters": [
    {
      "name": "batch_size",
      "type": "int",
      "default_value": "16",
      "description": "Training batch size",
      "min_value": "1",
      "max_value": "256"
    },
    {
      "name": "learning_rate",
      "type": "float",
      "default_value": "0.001",
      "description": "Adam learning rate",
      "min_value": "0.0001",
      "max_value": "0.01"
    },
    {
      "name": "epochs",
      "type": "int",
      "default_value": "60",
      "description": "Number of training epochs",
      "min_value": "1",
      "max_value": "100"
    },
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "10",
      "description": "Number of spoken commands / classes (e.g. 10 for digits, 35 for full Speech Commands set)",
      "min_value": "2",
      "max_value": "100"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 300], "params": {"source_type": "file", "folder_path": "examples/datasets/spoken_digits", "file_category": "audio", "audio_layout": "0", "sample_rate": "8000", "max_duration": "1.0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Train/Val Split", "pos": [250, 300], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [500, 300], "params": {"batch_size": "$batch_size", "epochs": "$epochs", "shuffle": "true", "early_stopping_patience": "15"}},
      {"id": "mel_spec", "type": "MelSpectrogram", "name": "Mel Spectrogram", "pos": [750, 300], "params": {"n_fft": "512", "hop_length": "256", "n_mels": "40", "log_scale": "true"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize", "pos": [1000, 300], "params": {"mean": "0.0", "std": "1.0"}},

      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [1250, 300]},
      {"id": "batchnorm", "type": "BatchNorm", "name": "BatchNorm", "pos": [1375, 450]},
      {"id": "fc1", "type": "Dense", "name": "Dense 256", "pos": [1500, 300], "params": {"units": "256"}},
      {"id": "relu1", "type": "ReLU", "name": "ReLU", "pos": [1750, 300]},
      {"id": "dropout1", "type": "Dropout", "name": "Dropout 0.3", "pos": [2000, 300], "params": {"rate": "0.3"}},
      {"id": "fc2", "type": "Dense", "name": "Dense 128", "pos": [2250, 300], "params": {"units": "128"}},
      {"id": "relu2", "type": "ReLU", "name": "ReLU", "pos": [2500, 300]},
      {"id": "dropout2", "type": "Dropout", "name": "Dropout 0.2", "pos": [2750, 300], "params": {"rate": "0.2"}},
      {"id": "fc3", "type": "Dense", "name": "Dense N", "pos": [3000, 300], "params": {"units": "$num_classes"}},

      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [3250, 300]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [3500, 300], "params": {"learning_rate": "$learning_rate"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [3750, 300], "params": {"num_classes": "$num_classes"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split"},
      {"from": "data_split", "to": "data_loader"},
      {"from": "data_loader", "to": "mel_spec"},
      {"from": "mel_spec", "to": "normalize"},
      {"from": "normalize", "to": "flatten"},
      {"from": "flatten", "to": "batchnorm"},
      {"from": "batchnorm", "to": "fc1"},
      {"from": "fc1", "to": "relu1"},
      {"from": "relu1", "to": "dropout1"},
      {"from": "dropout1", "to": "fc2"},
      {"from": "fc2", "to": "relu2"},
      {"from": "relu2", "to": "dropout2"},
      {"from": "dropout2", "to": "fc3"},
      {"from": "fc3", "to": "loss"},
      {"from": "data_loader", "to": "loss", "from_pin": 1, "to_pin": 1},
      {"from": "loss", "to": "optimizer"},
      {"from": "optimizer", "to": "output"}
    ]
  }
}
