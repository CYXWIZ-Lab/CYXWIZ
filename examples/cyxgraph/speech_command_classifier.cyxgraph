{
  "id": "speech_command_classifier",
  "name": "Speech Command Classifier",
  "description": "Spoken keyword classification pipeline for short audio clips. Loads a folder of labeled WAV/FLAC files (one subdirectory per spoken command — e.g. yes/, no/, up/, down/) and trains a Dense network on Mel spectrogram features. Designed for datasets like Google Speech Commands. Configure the DataInput node and point it at your audio root folder; the audio is resampled to 16 kHz and padded/truncated to 1 second. MelSpectrogram features (n_mels=128) are extracted on-the-fly per batch.",
  "category": "Training Pipeline",
  "tags": ["speech", "audio", "keyword", "classification", "spectrogram", "training"],
  "parameters": [
    {
      "name": "batch_size",
      "type": "int",
      "default_value": "32",
      "description": "Training batch size",
      "min_value": "1",
      "max_value": "256"
    },
    {
      "name": "learning_rate",
      "type": "float",
      "default_value": "0.001",
      "description": "Adam learning rate",
      "min_value": "0.0001",
      "max_value": "0.01"
    },
    {
      "name": "epochs",
      "type": "int",
      "default_value": "20",
      "description": "Number of training epochs",
      "min_value": "1",
      "max_value": "100"
    },
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "10",
      "description": "Number of spoken commands / classes (e.g. 10 for digits, 35 for full Speech Commands set)",
      "min_value": "2",
      "max_value": "100"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 300], "params": {"file_category": "audio", "sample_rate": "16000", "max_duration": "1.0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Train/Val Split", "pos": [250, 300], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [500, 300], "params": {"batch_size": "$batch_size", "epochs": "$epochs", "shuffle": "true"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize", "pos": [750, 300], "params": {"mean": "0.0", "std": "1.0"}},

      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [1000, 300]},
      {"id": "fc1", "type": "Dense", "name": "Dense 256", "pos": [1250, 300], "params": {"units": "256"}},
      {"id": "relu1", "type": "ReLU", "name": "ReLU", "pos": [1500, 300]},
      {"id": "dropout1", "type": "Dropout", "name": "Dropout 0.3", "pos": [1750, 300], "params": {"rate": "0.3"}},
      {"id": "fc2", "type": "Dense", "name": "Dense 128", "pos": [2000, 300], "params": {"units": "128"}},
      {"id": "relu2", "type": "ReLU", "name": "ReLU", "pos": [2250, 300]},
      {"id": "dropout2", "type": "Dropout", "name": "Dropout 0.2", "pos": [2500, 300], "params": {"rate": "0.2"}},
      {"id": "fc3", "type": "Dense", "name": "Dense N", "pos": [2750, 300], "params": {"units": "$num_classes"}},

      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [3000, 300]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [3250, 300], "params": {"learning_rate": "$learning_rate"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [3500, 300], "params": {"classes": "$num_classes"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split"},
      {"from": "data_split", "to": "data_loader"},
      {"from": "data_loader", "to": "normalize"},
      {"from": "normalize", "to": "flatten"},
      {"from": "flatten", "to": "fc1"},
      {"from": "fc1", "to": "relu1"},
      {"from": "relu1", "to": "dropout1"},
      {"from": "dropout1", "to": "fc2"},
      {"from": "fc2", "to": "relu2"},
      {"from": "relu2", "to": "dropout2"},
      {"from": "dropout2", "to": "fc3"},
      {"from": "fc3", "to": "loss"},
      {"from": "loss", "to": "optimizer"},
      {"from": "optimizer", "to": "output"}
    ]
  }
}
