{
  "id": "audio_test_01_fallback_mode",
  "name": "Audio Test 1 — Fallback Mode (no feature node)",
  "description": "Phase 2.1 audio test 1: Fallback mode. No Spectrogram/MelSpectrogram/MFCC node in the graph — the pipeline falls back to the dialog-baked defaults on AudioDatasetEntry. Expected log: 'GraphCompiler: audio feature extraction uses dialog defaults'. Expected feature shape: [128 x 313] (n_mels=128 from dialog default). Use this as a back-compat baseline: older audio graphs (including the original drone_sound_detector example from Phase 2.0) should behave exactly like this file. Configure the DataInput node to point at a folder with labeled audio subdirectories.",
  "category": "Training Pipeline",
  "tags": ["audio", "test", "phase2", "fallback", "mel-spectrogram", "training"],
  "parameters": [
    {"name": "batch_size", "type": "int", "default_value": "64", "description": "Training batch size", "min_value": "1", "max_value": "256"},
    {"name": "learning_rate", "type": "float", "default_value": "0.0005", "description": "Adam learning rate", "min_value": "0.0001", "max_value": "0.01"},
    {"name": "epochs", "type": "int", "default_value": "5", "description": "Number of training epochs", "min_value": "1", "max_value": "200"}
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 300], "params": {"file_category": "audio", "sample_rate": "16000", "max_duration": "1.0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Train/Val Split", "pos": [250, 300], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [500, 300], "params": {"batch_size": "$batch_size", "epochs": "$epochs", "shuffle": "true", "seed": "42"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize", "pos": [750, 300], "params": {"mean": "0.0", "std": "1.0"}},

      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [1000, 300]},

      {"id": "fc1", "type": "Dense", "name": "Dense 512", "pos": [1250, 300], "params": {"units": "512"}},
      {"id": "relu1", "type": "ReLU", "name": "ReLU", "pos": [1500, 300]},
      {"id": "drop1", "type": "Dropout", "name": "Dropout 0.4", "pos": [1750, 300], "params": {"rate": "0.4"}},

      {"id": "fc2", "type": "Dense", "name": "Dense 128", "pos": [2000, 300], "params": {"units": "128"}},
      {"id": "relu2", "type": "ReLU", "name": "ReLU", "pos": [2250, 300]},

      {"id": "fc3", "type": "Dense", "name": "Dense 2", "pos": [2500, 300], "params": {"units": "2"}},

      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [2750, 300]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [3000, 300], "params": {"learning_rate": "$learning_rate"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [3250, 300], "params": {"classes": "2"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split"},
      {"from": "data_split", "to": "data_loader"},
      {"from": "data_loader", "to": "normalize"},
      {"from": "normalize", "to": "flatten"},
      {"from": "flatten", "to": "fc1"},
      {"from": "fc1", "to": "relu1"},
      {"from": "relu1", "to": "drop1"},
      {"from": "drop1", "to": "fc2"},
      {"from": "fc2", "to": "relu2"},
      {"from": "relu2", "to": "fc3"},
      {"from": "fc3", "to": "loss"},
      {"from": "loss", "to": "optimizer"},
      {"from": "optimizer", "to": "output"}
    ]
  }
}
