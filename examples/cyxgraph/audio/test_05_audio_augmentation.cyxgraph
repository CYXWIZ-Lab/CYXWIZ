{
  "id": "audio_test_05_audio_augmentation",
  "name": "Audio Test 5 — MelSpectrogram + AudioAugmentation",
  "description": "Phase 2.1 audio test 5: Graph-driven audio augmentation on top of MelSpectrogram feature extraction. Adds an AudioAugmentation node with noise_level=0.05 to simulate microphone/environmental noise during training. The augmentation applies to the raw waveform BEFORE the spectrogram is computed, so the noise is imprinted into the actual mel features — real augmentation, not just tensor jitter. v1 uses hardcoded ranges: ±10% time stretch, ±2 semitone pitch shift (when enabled). Noise is additive Gaussian with user-configurable level. Expected logs: 'GraphCompiler: AudioAugmentation noise=0.05, time_stretch=false, pitch_shift=false' and 'AudioDatasetBatcher: graph augmentation enabled'. Bonus side-effect: silent files in the dataset (see Kaggle Binary_Drone_Audio's 1089 zero-filled wavs) are no longer rejected when noise augmentation is on — AddNoise makes them non-silent, so they pass the silent-file guard and contribute a small amount of signal.",
  "category": "Training Pipeline",
  "tags": ["audio", "test", "phase2", "augmentation", "mel-spectrogram", "robustness", "training"],
  "parameters": [
    {"name": "batch_size", "type": "int", "default_value": "64", "description": "Training batch size", "min_value": "1", "max_value": "256"},
    {"name": "learning_rate", "type": "float", "default_value": "0.0005", "description": "Adam learning rate", "min_value": "0.0001", "max_value": "0.01"},
    {"name": "epochs", "type": "int", "default_value": "10", "description": "Number of training epochs (augmentation benefits from more epochs)", "min_value": "1", "max_value": "200"},
    {"name": "noise_level", "type": "float", "default_value": "0.05", "description": "Additive Gaussian noise amplitude (0 = off, 0.05 = subtle, 0.1 = aggressive)", "min_value": "0.0", "max_value": "0.5"}
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 300], "params": {"file_category": "audio", "sample_rate": "16000", "max_duration": "1.0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Train/Val Split", "pos": [250, 300], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [500, 300], "params": {"batch_size": "$batch_size", "epochs": "$epochs", "shuffle": "true", "seed": "42"}},

      {"id": "augment", "type": "AudioAugmentation", "name": "AudioAugmentation", "pos": [750, 300], "params": {"noise_level": "$noise_level", "time_stretch": "false", "pitch_shift": "false"}},

      {"id": "mel_spec", "type": "MelSpectrogram", "name": "MelSpectrogram", "pos": [1000, 300], "params": {"n_fft": "512", "hop_length": "256", "n_mels": "64", "log_scale": "true"}},

      {"id": "normalize", "type": "Normalize", "name": "Normalize", "pos": [1250, 300], "params": {"mean": "0.0", "std": "1.0"}},
      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [1500, 300]},

      {"id": "fc1", "type": "Dense", "name": "Dense 512", "pos": [1750, 300], "params": {"units": "512"}},
      {"id": "relu1", "type": "ReLU", "name": "ReLU", "pos": [2000, 300]},
      {"id": "drop1", "type": "Dropout", "name": "Dropout 0.4", "pos": [2250, 300], "params": {"rate": "0.4"}},

      {"id": "fc2", "type": "Dense", "name": "Dense 128", "pos": [2500, 300], "params": {"units": "128"}},
      {"id": "relu2", "type": "ReLU", "name": "ReLU", "pos": [2750, 300]},

      {"id": "fc3", "type": "Dense", "name": "Dense 2", "pos": [3000, 300], "params": {"units": "2"}},

      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [3250, 300]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [3500, 300], "params": {"learning_rate": "$learning_rate"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [3750, 300], "params": {"classes": "2"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split"},
      {"from": "data_split", "to": "data_loader"},
      {"from": "data_loader", "to": "augment"},
      {"from": "augment", "to": "mel_spec"},
      {"from": "mel_spec", "to": "normalize"},
      {"from": "normalize", "to": "flatten"},
      {"from": "flatten", "to": "fc1"},
      {"from": "fc1", "to": "relu1"},
      {"from": "relu1", "to": "drop1"},
      {"from": "drop1", "to": "fc2"},
      {"from": "fc2", "to": "relu2"},
      {"from": "relu2", "to": "fc3"},
      {"from": "fc3", "to": "loss"},
      {"from": "loss", "to": "optimizer"},
      {"from": "optimizer", "to": "output"}
    ]
  }
}
