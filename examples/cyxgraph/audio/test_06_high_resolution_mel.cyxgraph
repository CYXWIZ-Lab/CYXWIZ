{
  "id": "audio_test_06_high_resolution_mel",
  "name": "Audio Test 6 — High-resolution MelSpectrogram",
  "description": "Phase 2.1 audio test 6: Demonstrates high-resolution feature extraction with graph node overrides. Uses a larger FFT window (n_fft=1024 instead of 512) and more mel bins (n_mels=128) for finer frequency resolution. The larger FFT captures slower features (more accurate for low-frequency drone motor hum and bass), while more mel bins preserve harmonic structure. Feature shape: [128 x 157] — fewer time frames because the larger window hops produce fewer frames across the same 1-second clip. Input_size=20096, similar magnitude to the n_mels=64 test but with doubled frequency resolution and halved time resolution. Shows that the graph node can override not just n_mels but the STFT parameters too (n_fft, hop_length). Useful baseline for comparing against the default [128 x 313] configuration — same n_mels but different time/frequency tradeoff.",
  "category": "Training Pipeline",
  "tags": ["audio", "test", "phase2", "mel-spectrogram", "high-resolution", "stft", "training"],
  "parameters": [
    {"name": "batch_size", "type": "int", "default_value": "64", "description": "Training batch size", "min_value": "1", "max_value": "256"},
    {"name": "learning_rate", "type": "float", "default_value": "0.0005", "description": "Adam learning rate", "min_value": "0.0001", "max_value": "0.01"},
    {"name": "epochs", "type": "int", "default_value": "5", "description": "Number of training epochs", "min_value": "1", "max_value": "200"},
    {"name": "n_fft", "type": "int", "default_value": "1024", "description": "FFT window size — larger = better low-freq resolution", "min_value": "256", "max_value": "2048"},
    {"name": "hop_length", "type": "int", "default_value": "512", "description": "Hop between windows — larger = fewer time frames", "min_value": "64", "max_value": "1024"},
    {"name": "n_mels", "type": "int", "default_value": "128", "description": "Number of mel bins", "min_value": "16", "max_value": "256"}
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 300], "params": {"file_category": "audio", "sample_rate": "16000", "max_duration": "1.0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Train/Val Split", "pos": [250, 300], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [500, 300], "params": {"batch_size": "$batch_size", "epochs": "$epochs", "shuffle": "true", "seed": "42"}},

      {"id": "mel_spec", "type": "MelSpectrogram", "name": "MelSpectrogram", "pos": [750, 300], "params": {"n_fft": "$n_fft", "hop_length": "$hop_length", "n_mels": "$n_mels", "log_scale": "true"}},

      {"id": "normalize", "type": "Normalize", "name": "Normalize", "pos": [1000, 300], "params": {"mean": "0.0", "std": "1.0"}},
      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [1250, 300]},

      {"id": "fc1", "type": "Dense", "name": "Dense 512", "pos": [1500, 300], "params": {"units": "512"}},
      {"id": "relu1", "type": "ReLU", "name": "ReLU", "pos": [1750, 300]},
      {"id": "drop1", "type": "Dropout", "name": "Dropout 0.4", "pos": [2000, 300], "params": {"rate": "0.4"}},

      {"id": "fc2", "type": "Dense", "name": "Dense 256", "pos": [2250, 300], "params": {"units": "256"}},
      {"id": "relu2", "type": "ReLU", "name": "ReLU", "pos": [2500, 300]},
      {"id": "drop2", "type": "Dropout", "name": "Dropout 0.3", "pos": [2750, 300], "params": {"rate": "0.3"}},

      {"id": "fc3", "type": "Dense", "name": "Dense 2", "pos": [3000, 300], "params": {"units": "2"}},

      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [3250, 300]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [3500, 300], "params": {"learning_rate": "$learning_rate"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [3750, 300], "params": {"classes": "2"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split"},
      {"from": "data_split", "to": "data_loader"},
      {"from": "data_loader", "to": "mel_spec"},
      {"from": "mel_spec", "to": "normalize"},
      {"from": "normalize", "to": "flatten"},
      {"from": "flatten", "to": "fc1"},
      {"from": "fc1", "to": "relu1"},
      {"from": "relu1", "to": "drop1"},
      {"from": "drop1", "to": "fc2"},
      {"from": "fc2", "to": "relu2"},
      {"from": "relu2", "to": "drop2"},
      {"from": "drop2", "to": "fc3"},
      {"from": "fc3", "to": "loss"},
      {"from": "loss", "to": "optimizer"},
      {"from": "optimizer", "to": "output"}
    ]
  }
}
