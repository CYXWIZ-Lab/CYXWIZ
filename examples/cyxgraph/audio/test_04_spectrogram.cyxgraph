{
  "id": "audio_test_04_spectrogram",
  "name": "Audio Test 4 — Raw Spectrogram node override",
  "description": "Phase 2.1 audio test 4: Graph-driven raw Spectrogram (STFT magnitude, no mel filterbank). Drops a Spectrogram node with n_fft=512 into the pipeline. Feature shape becomes [257 x 313] (257 = n_fft/2 + 1 frequency bins). This is the largest feature map of the three types — input_size=80441, ~2x MelSpectrogram and ~20x MFCC. Use raw spectrograms when you want full frequency resolution without the mel-scale compression, e.g., for detecting tonal signatures that the mel scale smears out (drones, engine noise, alarms). The network needs more capacity to handle the higher-dimensional input, so this example uses a wider first Dense layer (1024 units). Expected logs: 'GraphCompiler: Spectrogram n_fft=512, hop=256, log=true' and 'audio feature extraction driven by graph node (type=1)'.",
  "category": "Training Pipeline",
  "tags": ["audio", "test", "phase2", "spectrogram", "stft", "feature-extraction", "training"],
  "parameters": [
    {"name": "batch_size", "type": "int", "default_value": "32", "description": "Training batch size (smaller because features are larger)", "min_value": "1", "max_value": "128"},
    {"name": "learning_rate", "type": "float", "default_value": "0.0003", "description": "Adam learning rate (lower for wider network stability)", "min_value": "0.0001", "max_value": "0.01"},
    {"name": "epochs", "type": "int", "default_value": "5", "description": "Number of training epochs", "min_value": "1", "max_value": "200"},
    {"name": "n_fft", "type": "int", "default_value": "512", "description": "FFT window size (higher = more frequency bins)", "min_value": "128", "max_value": "2048"}
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 300], "params": {"file_category": "audio", "sample_rate": "16000", "max_duration": "1.0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Train/Val Split", "pos": [250, 300], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [500, 300], "params": {"batch_size": "$batch_size", "epochs": "$epochs", "shuffle": "true", "seed": "42"}},

      {"id": "spec", "type": "Spectrogram", "name": "Spectrogram", "pos": [750, 300], "params": {"n_fft": "$n_fft", "hop_length": "256", "log_scale": "true"}},

      {"id": "normalize", "type": "Normalize", "name": "Normalize", "pos": [1000, 300], "params": {"mean": "0.0", "std": "1.0"}},
      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [1250, 300]},

      {"id": "fc1", "type": "Dense", "name": "Dense 1024", "pos": [1500, 300], "params": {"units": "1024"}},
      {"id": "relu1", "type": "ReLU", "name": "ReLU", "pos": [1750, 300]},
      {"id": "drop1", "type": "Dropout", "name": "Dropout 0.5", "pos": [2000, 300], "params": {"rate": "0.5"}},

      {"id": "fc2", "type": "Dense", "name": "Dense 256", "pos": [2250, 300], "params": {"units": "256"}},
      {"id": "relu2", "type": "ReLU", "name": "ReLU", "pos": [2500, 300]},
      {"id": "drop2", "type": "Dropout", "name": "Dropout 0.4", "pos": [2750, 300], "params": {"rate": "0.4"}},

      {"id": "fc3", "type": "Dense", "name": "Dense 2", "pos": [3000, 300], "params": {"units": "2"}},

      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [3250, 300]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [3500, 300], "params": {"learning_rate": "$learning_rate"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [3750, 300], "params": {"classes": "2"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split"},
      {"from": "data_split", "to": "data_loader"},
      {"from": "data_loader", "to": "spec"},
      {"from": "spec", "to": "normalize"},
      {"from": "normalize", "to": "flatten"},
      {"from": "flatten", "to": "fc1"},
      {"from": "fc1", "to": "relu1"},
      {"from": "relu1", "to": "drop1"},
      {"from": "drop1", "to": "fc2"},
      {"from": "fc2", "to": "relu2"},
      {"from": "relu2", "to": "drop2"},
      {"from": "drop2", "to": "fc3"},
      {"from": "fc3", "to": "loss"},
      {"from": "loss", "to": "optimizer"},
      {"from": "optimizer", "to": "output"}
    ]
  }
}
