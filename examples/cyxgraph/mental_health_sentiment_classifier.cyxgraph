{
  "id": "mental_health_sentiment_classifier",
  "name": "Mental Health Sentiment Classifier",
  "description": "Multi-class mental health text classification from first-person statements. Classifies short self-reported text into 7 mental health categories: Normal, Depression, Suicidal, Anxiety, Bipolar, Stress, Personality disorder. Uses the legacy fallback text path from DataInput defaults, with explicit Data and Labels pin routes for compile-time honesty. Target file: D:/demo/mrcj/datasets/sentiment analysis/sentiment_mental_health.csv, columns statement and status.",
  "category": "Training Pipeline",
  "tags": [
    "text",
    "sentiment",
    "mental-health",
    "nlp",
    "classification",
    "kaggle",
    "training"
  ],
  "parameters": [
    {
      "name": "batch_size",
      "type": "int",
      "default_value": "64",
      "description": "Training batch size",
      "min_value": "1",
      "max_value": "512"
    },
    {
      "name": "learning_rate",
      "type": "float",
      "default_value": "0.0005",
      "description": "Adam learning rate --- low for stable NLP convergence on imbalanced classes",
      "min_value": "0.00001",
      "max_value": "0.01"
    },
    {
      "name": "epochs",
      "type": "int",
      "default_value": "15",
      "description": "Number of training epochs",
      "min_value": "1",
      "max_value": "200"
    },
    {
      "name": "max_length",
      "type": "int",
      "default_value": "128",
      "description": "Max tokens per statement (pad/truncate). 128 covers ~85% of statements; bump to 256 for full coverage at the cost of 4x the first-dense layer size",
      "min_value": "32",
      "max_value": "1024"
    },
    {
      "name": "embedding_dim",
      "type": "int",
      "default_value": "64",
      "description": "Token embedding vector size. Smaller = faster training but less expressive. 64 is a good first-pass for 7-class sentiment; bump to 128 or 256 for more capacity",
      "min_value": "8",
      "max_value": "512"
    },
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "7",
      "description": "Mental health categories: Normal, Depression, Suicidal, Anxiety, Bipolar, Stress, Personality disorder",
      "min_value": "2",
      "max_value": "32"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.4",
      "description": "Regularization strength --- higher helps with the imbalanced minority classes",
      "min_value": "0.0",
      "max_value": "0.7"
    }
  ],
  "template": {
    "nodes": [
      {
        "id": "data_input",
        "type": "DataInput",
        "name": "Data Input",
        "pos": [
          0,
          300
        ],
        "params": {
          "source_type": "file",
          "file_category": "text",
          "file_path": "D:/demo/mrcj/datasets/sentiment analysis/sentiment_mental_health.csv",
          "text_column": "statement",
          "text_label_column": "status",
          "text_tokenizer_type": "1",
          "text_max_length": "$max_length",
          "text_lowercase": "true",
          "text_min_freq": "2",
          "text_max_vocab_size": "20000"
        }
      },
      {
        "id": "data_split",
        "type": "DataSplit",
        "name": "Stratified Split",
        "pos": [
          250,
          300
        ],
        "params": {
          "train_ratio": "0.8",
          "val_ratio": "0.1",
          "test_ratio": "0.1",
          "stratified": "true",
          "seed": "42"
        }
      },
      {
        "id": "data_loader",
        "type": "DataLoader",
        "name": "DataLoader",
        "pos": [
          500,
          300
        ],
        "params": {
          "batch_size": "$batch_size",
          "epochs": "$epochs",
          "shuffle": "true",
          "seed": "42",
          "validation_freq": "1"
        }
      },
      {
        "id": "embedding",
        "type": "Embedding",
        "name": "Embedding 20k x N",
        "pos": [
          750,
          300
        ],
        "params": {
          "num_embeddings": "20000",
          "embedding_dim": "$embedding_dim",
          "padding_idx": "0"
        }
      },
      {
        "id": "flatten",
        "type": "Flatten",
        "name": "Flatten",
        "pos": [
          1000,
          300
        ]
      },
      {
        "id": "fc1",
        "type": "Dense",
        "name": "Dense 256",
        "pos": [
          1250,
          300
        ],
        "params": {
          "units": "256"
        }
      },
      {
        "id": "relu1",
        "type": "ReLU",
        "name": "ReLU",
        "pos": [
          1500,
          300
        ]
      },
      {
        "id": "drop1",
        "type": "Dropout",
        "name": "Dropout",
        "pos": [
          1750,
          300
        ],
        "params": {
          "rate": "$dropout_rate"
        }
      },
      {
        "id": "fc2",
        "type": "Dense",
        "name": "Dense 64",
        "pos": [
          2000,
          300
        ],
        "params": {
          "units": "64"
        }
      },
      {
        "id": "relu2",
        "type": "ReLU",
        "name": "ReLU",
        "pos": [
          2250,
          300
        ]
      },
      {
        "id": "drop2",
        "type": "Dropout",
        "name": "Dropout",
        "pos": [
          2500,
          300
        ],
        "params": {
          "rate": "0.3"
        }
      },
      {
        "id": "fc4",
        "type": "Dense",
        "name": "Dense N",
        "pos": [
          3500,
          300
        ],
        "params": {
          "units": "$num_classes"
        }
      },
      {
        "id": "loss",
        "type": "CrossEntropyLoss",
        "name": "CrossEntropy",
        "pos": [
          3750,
          300
        ]
      },
      {
        "id": "optimizer",
        "type": "Adam",
        "name": "Adam",
        "pos": [
          4000,
          300
        ],
        "params": {
          "learning_rate": "$learning_rate"
        }
      },
      {
        "id": "output",
        "type": "Output",
        "name": "Output",
        "pos": [
          4250,
          300
        ],
        "params": {
          "classes": "$num_classes"
        }
      }
    ],
    "links": [
      {
        "from": "data_input",
        "to": "data_split",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "data_input",
        "to": "data_split",
        "from_pin": 1,
        "to_pin": 1
      },
      {
        "from": "data_split",
        "to": "data_loader",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "data_split",
        "to": "data_loader",
        "from_pin": 1,
        "to_pin": 1
      },
      {
        "from": "data_loader",
        "to": "embedding",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "embedding",
        "to": "flatten",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "flatten",
        "to": "fc1",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "fc1",
        "to": "relu1",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "relu1",
        "to": "drop1",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "drop1",
        "to": "fc2",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "fc2",
        "to": "relu2",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "relu2",
        "to": "drop2",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "drop2",
        "to": "fc4",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "fc4",
        "to": "loss",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "data_loader",
        "to": "loss",
        "from_pin": 1,
        "to_pin": 1
      },
      {
        "from": "loss",
        "to": "optimizer",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "optimizer",
        "to": "output",
        "from_pin": 0,
        "to_pin": 0
      }
    ]
  }
}
