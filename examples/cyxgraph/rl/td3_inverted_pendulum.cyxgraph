{
  "id": "td3_inverted_pendulum",
  "name": "TD3 on InvertedPendulum-v5",
  "description": "Twin Delayed DDPG on the MuJoCo Simulation plugin's InvertedPendulum-v5 (load the plugin first) with the TD3 node's defaults (Stable-Baselines3's, with Gaussian action noise of 0.1): 1 copy, layers of 400 and 300 with ReLU, stops when the mean return of the last 100 episodes reaches 950 (101,000-121,000 steps; Stable-Baselines3: 109,000-123,100), within 150,000 steps. About 13-18 minutes on an NVIDIA GPU with the CUDA GPU pack. Open it, then Train (F5).",
  "category": "Reinforcement Learning",
  "tags": [
    "td3",
    "twin delayed ddpg",
    "off-policy",
    "reinforcement",
    "rl",
    "policy",
    "invertedpendulum",
    "mujoco"
  ],
  "template": {
    "nodes": [
      {
        "id": "env",
        "type": "RLEnvironment",
        "name": "Environment",
        "pos": [
          0,
          300
        ],
        "params": {
          "environment": "com.cyxwiz.simulation.mujoco:InvertedPendulum-v5",
          "copies": "1"
        }
      },
      {
        "id": "p1",
        "type": "Dense",
        "name": "Actor Dense 1",
        "pos": [
          220,
          100
        ],
        "params": {
          "units": "400"
        }
      },
      {
        "id": "pa1",
        "type": "ReLU",
        "name": "Actor Activation 1",
        "pos": [
          400,
          100
        ]
      },
      {
        "id": "p2",
        "type": "Dense",
        "name": "Actor Dense 2",
        "pos": [
          580,
          100
        ],
        "params": {
          "units": "300"
        }
      },
      {
        "id": "pa2",
        "type": "ReLU",
        "name": "Actor Activation 2",
        "pos": [
          760,
          100
        ]
      },
      {
        "id": "phead",
        "type": "PolicyHead",
        "name": "Policy Head",
        "pos": [
          940,
          100
        ]
      },
      {
        "id": "q1",
        "type": "Dense",
        "name": "Q Dense 1",
        "pos": [
          220,
          500
        ],
        "params": {
          "units": "400"
        }
      },
      {
        "id": "qa1",
        "type": "ReLU",
        "name": "Q Activation 1",
        "pos": [
          400,
          500
        ]
      },
      {
        "id": "q2",
        "type": "Dense",
        "name": "Q Dense 2",
        "pos": [
          580,
          500
        ],
        "params": {
          "units": "300"
        }
      },
      {
        "id": "qa2",
        "type": "ReLU",
        "name": "Q Activation 2",
        "pos": [
          760,
          500
        ]
      },
      {
        "id": "qhead",
        "type": "QHead",
        "name": "Q Head",
        "pos": [
          940,
          500
        ]
      },
      {
        "id": "td3",
        "type": "TD3",
        "name": "TD3",
        "pos": [
          1160,
          300
        ],
        "params": {
          "total_timesteps": "150000",
          "stop_at_return": "true",
          "target_return": "950"
        }
      }
    ],
    "links": [
      {
        "from": "env",
        "to": "p1"
      },
      {
        "from": "p1",
        "to": "pa1"
      },
      {
        "from": "pa1",
        "to": "p2"
      },
      {
        "from": "p2",
        "to": "pa2"
      },
      {
        "from": "pa2",
        "to": "phead"
      },
      {
        "from": "env",
        "to": "q1"
      },
      {
        "from": "q1",
        "to": "qa1"
      },
      {
        "from": "qa1",
        "to": "q2"
      },
      {
        "from": "q2",
        "to": "qa2"
      },
      {
        "from": "qa2",
        "to": "qhead"
      },
      {
        "from": "phead",
        "to": "td3",
        "to_pin": 0
      },
      {
        "from": "env",
        "from_pin": 1,
        "to": "td3",
        "to_pin": 1
      },
      {
        "from": "qhead",
        "to": "td3",
        "to_pin": 2
      }
    ]
  }
}
