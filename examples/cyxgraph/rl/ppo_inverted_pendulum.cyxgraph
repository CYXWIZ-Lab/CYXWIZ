{
  "id": "ppo_inverted_pendulum",
  "name": "PPO on InvertedPendulum-v5",
  "description": "PPO on the MuJoCo Simulation plugin's InvertedPendulum-v5 (load the plugin first), tuned: 4 copies, stops when the last 100 episodes average 950 (about 120,000 steps, a few minutes). Open it, then Train (F5).",
  "category": "Reinforcement Learning",
  "tags": [
    "ppo",
    "reinforcement",
    "rl",
    "policy",
    "cartpole",
    "mujoco"
  ],
  "template": {
    "nodes": [
      {
        "id": "env",
        "type": "RLEnvironment",
        "name": "Environment",
        "pos": [
          0,
          300
        ],
        "params": {
          "environment": "com.cyxwiz.simulation.mujoco:InvertedPendulum-v5",
          "copies": "4"
        }
      },
      {
        "id": "p1",
        "type": "Dense",
        "name": "Policy Dense 1",
        "pos": [
          220,
          100
        ],
        "params": {
          "units": "64"
        }
      },
      {
        "id": "pa1",
        "type": "Tanh",
        "name": "Policy Activation 1",
        "pos": [
          400,
          100
        ]
      },
      {
        "id": "p2",
        "type": "Dense",
        "name": "Policy Dense 2",
        "pos": [
          580,
          100
        ],
        "params": {
          "units": "64"
        }
      },
      {
        "id": "pa2",
        "type": "Tanh",
        "name": "Policy Activation 2",
        "pos": [
          760,
          100
        ]
      },
      {
        "id": "phead",
        "type": "PolicyHead",
        "name": "Policy Head",
        "pos": [
          940,
          100
        ]
      },
      {
        "id": "v1",
        "type": "Dense",
        "name": "Value Dense 1",
        "pos": [
          220,
          500
        ],
        "params": {
          "units": "64"
        }
      },
      {
        "id": "va1",
        "type": "Tanh",
        "name": "Value Activation 1",
        "pos": [
          400,
          500
        ]
      },
      {
        "id": "v2",
        "type": "Dense",
        "name": "Value Dense 2",
        "pos": [
          580,
          500
        ],
        "params": {
          "units": "64"
        }
      },
      {
        "id": "va2",
        "type": "Tanh",
        "name": "Value Activation 2",
        "pos": [
          760,
          500
        ]
      },
      {
        "id": "vhead",
        "type": "ValueHead",
        "name": "Value Head",
        "pos": [
          940,
          500
        ]
      },
      {
        "id": "ppo",
        "type": "PPO",
        "name": "PPO",
        "pos": [
          1160,
          300
        ],
        "params": {
          "total_timesteps": "300000",
          "n_steps": "512",
          "batch_size": "64",
          "n_epochs": "10",
          "learning_rate": "0.0003",
          "gamma": "0.999",
          "gae_lambda": "0.9",
          "clip_range": "0.2",
          "ent_coef": "0",
          "vf_coef": "0.5",
          "max_grad_norm": "0.5",
          "stop_at_return": "true",
          "target_return": "950",
          "normalize_observations": "false",
          "normalize_rewards": "false"
        }
      }
    ],
    "links": [
      {
        "from": "env",
        "to": "p1"
      },
      {
        "from": "p1",
        "to": "pa1"
      },
      {
        "from": "pa1",
        "to": "p2"
      },
      {
        "from": "p2",
        "to": "pa2"
      },
      {
        "from": "pa2",
        "to": "phead"
      },
      {
        "from": "env",
        "to": "v1"
      },
      {
        "from": "v1",
        "to": "va1"
      },
      {
        "from": "va1",
        "to": "v2"
      },
      {
        "from": "v2",
        "to": "va2"
      },
      {
        "from": "va2",
        "to": "vhead"
      },
      {
        "from": "phead",
        "to": "ppo",
        "to_pin": 0
      },
      {
        "from": "env",
        "from_pin": 1,
        "to": "ppo",
        "to_pin": 1
      },
      {
        "from": "vhead",
        "to": "ppo",
        "to_pin": 2
      }
    ]
  }
}
