        "pos": [
          580,
          500
        ],
        "params": {
          "units": "64"
        }
      },
      {
        "id": "va2",
        "type": "Tanh",
        "name": "Value Activation 2",
        "pos": [
          760,
          500
        ]
      },
      {
        "id": "vhead",
        "type": "ValueHead",
        "name": "Value Head",
        "pos": [
          940,
          500
        ]
      },
      {
        "id": "ppo",
        "type": "PPO",
        "name": "PPO",
        "pos": [
          1160,
          300
        ],
        "params": {
          "total_timesteps": "100000",
          "n_steps": "32",
          "batch_size": "256",
          "n_epochs": "20",
          "learning_rate": "0.001",
          "gamma": "0.98",
          "gae_lambda": "0.8",
          "clip_range": "0.2",
          "ent_coef": "0",
          "vf_coef": "0.5",
          "max_grad_norm": "0.5",
          "stop_at_return": "true",
          "target_return": "475",
          "normalize_observations": "false",
          "normalize_rewards": "false"
        }
      }
    ],
    "links": [
      {
        "from": "env",
        "to": "p1"
      },
