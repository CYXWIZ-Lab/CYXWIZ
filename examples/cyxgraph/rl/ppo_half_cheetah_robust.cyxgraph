{
  "id": "ppo_half_cheetah_robust",
  "name": "PPO on HalfCheetah-v5, robust",
  "description": "HalfCheetah-v5 trained for rough ground, slopes, steps and obstacles: a curriculum raises the ground difficulty as the mean return passes 1500, random pushes every 3 s, friction and mass varied, and Look ahead (the ground 0.2 to 2.0 m ahead) in the observation. 2,000,000 steps.",
  "category": "Reinforcement Learning",
  "tags": [
    "ppo",
    "reinforcement",
    "rl",
    "policy",
    "halfcheetah",
    "mujoco",
    "robustness",
    "curriculum",
    "look ahead"
  ],
  "template": {
    "nodes": [
      {
        "id": "env",
        "type": "RLEnvironment",
        "name": "Environment",
        "pos": [
          0,
          300
        ],
        "params": {
          "environment": "com.cyxwiz.simulation.mujoco:HalfCheetah-v5",
          "copies": "1",
          "setting.grounds": "rough,slopes,steps,obstacles",
          "setting.difficulty_from": "0",
          "setting.difficulty_to": "1",
          "setting.curriculum": "1500",
          "setting.push_every": "3",
          "setting.push_speed": "0.5",
          "setting.friction_percent": "20",
          "setting.mass_percent": "10",
          "setting.look_ahead": "1"
        }
      },
      {
        "id": "p1",
        "type": "Dense",
        "name": "Policy Dense 1",
        "pos": [
          220,
          100
        ],
        "params": {
          "units": "256"
        }
      },
      {
        "id": "pa1",
        "type": "ReLU",
        "name": "Policy Activation 1",
        "pos": [
          400,
          100
        ]
      },
      {
        "id": "p2",
        "type": "Dense",
        "name": "Policy Dense 2",
        "pos": [
          580,
          100
        ],
        "params": {
          "units": "256"
        }
      },
      {
        "id": "pa2",
        "type": "ReLU",
        "name": "Policy Activation 2",
        "pos": [
          760,
          100
        ]
      },
      {
        "id": "phead",
        "type": "PolicyHead",
        "name": "Policy Head",
        "pos": [
          940,
          100
        ],
        "params": {
          "log_std_init": "-2"
        }
      },
      {
        "id": "v1",
        "type": "Dense",
        "name": "Value Dense 1",
        "pos": [
          220,
          500
        ],
        "params": {
          "units": "256"
        }
      },
      {
        "id": "va1",
        "type": "ReLU",
        "name": "Value Activation 1",
        "pos": [
          400,
          500
        ]
      },
      {
        "id": "v2",
        "type": "Dense",
        "name": "Value Dense 2",
        "pos": [
          580,
          500
        ],
        "params": {
          "units": "256"
        }
      },
      {
        "id": "va2",
        "type": "ReLU",
        "name": "Value Activation 2",
        "pos": [
          760,
          500
        ]
      },
      {
        "id": "vhead",
        "type": "ValueHead",
        "name": "Value Head",
        "pos": [
          940,
          500
        ]
      },
      {
        "id": "ppo",
        "type": "PPO",
        "name": "PPO",
        "pos": [
          1160,
          300
        ],
        "params": {
          "total_timesteps": "2000000",
          "n_steps": "512",
          "batch_size": "64",
          "n_epochs": "20",
          "learning_rate": "2.0633e-05",
          "gamma": "0.98",
          "gae_lambda": "0.92",
          "clip_range": "0.1",
          "ent_coef": "0.000401762",
          "vf_coef": "0.58096",
          "max_grad_norm": "0.8",
          "stop_at_return": "false",
          "target_return": "4800",
          "normalize_observations": "true",
          "normalize_rewards": "true"
        }
      }
    ],
    "links": [
      {
        "from": "env",
        "to": "p1"
      },
      {
        "from": "p1",
        "to": "pa1"
      },
      {
        "from": "pa1",
        "to": "p2"
      },
      {
        "from": "p2",
        "to": "pa2"
      },
      {
        "from": "pa2",
        "to": "phead"
      },
      {
        "from": "env",
        "to": "v1"
      },
      {
        "from": "v1",
        "to": "va1"
      },
      {
        "from": "va1",
        "to": "v2"
      },
      {
        "from": "v2",
        "to": "va2"
      },
      {
        "from": "va2",
        "to": "vhead"
      },
      {
        "from": "phead",
        "to": "ppo",
        "to_pin": 0
      },
      {
        "from": "env",
        "from_pin": 1,
        "to": "ppo",
        "to_pin": 1
      },
      {
        "from": "vhead",
        "to": "ppo",
        "to_pin": 2
      }
    ]
  }
}