{
  "id": "test_pin_predictions_wrong_source",
  "name": "[TEST] Loss.Predictions wired to label stream instead of model",
  "description": "Compile-gate test fixture for the 2026-04-17 Predictions-reachability check. Loss.Predictions HAS an incoming wire — but it's wired to DataInput.Labels (the label stream) instead of the model's output. Required-input check passes. Reachability fails: 'Loss node CrossEntropy has its Predictions pin wired, but the upstream chain never passes through a model layer or Output node'. Before the check landed, this graph would compile and 'train' the loss on labels-vs-labels — perfect 0 loss with no learning, no error.",
  "category": "Test Fixtures",
  "tags": ["test", "compile-gate", "pin-connectivity", "expected-fail"],
  "parameters": [],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 260],
       "params": {"file_type": "csv", "has_header": "true",
                  "label_column": "class", "dataset_name": "mnist_784"}},
      {"id": "data_split", "type": "DataSplit", "name": "Train/Val/Test Split",
       "pos": [260, 260],
       "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1",
                  "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader",
       "pos": [520, 260],
       "params": {"batch_size": "128", "shuffle": "true",
                  "drop_last": "false", "num_workers": "0"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize",
       "pos": [780, 260],
       "params": {"mean": "0.0", "std": "255.0"}},
      {"id": "fc1", "type": "Dense", "name": "Dense", "pos": [1040, 260],
       "params": {"units": "128"}},
      {"id": "relu1", "type": "ReLU", "name": "ReLU", "pos": [1240, 260]},
      {"id": "fc2", "type": "Dense", "name": "Dense", "pos": [1420, 260],
       "params": {"units": "64"}},
      {"id": "relu2", "type": "ReLU", "name": "ReLU", "pos": [1620, 260]},
      {"id": "fc3", "type": "Dense", "name": "Dense", "pos": [1800, 260],
       "params": {"units": "10"}},
      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy",
       "pos": [2000, 320]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [2200, 320],
       "params": {"learning_rate": "0.001", "epochs": "10"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [2400, 320],
       "params": {"classes": "10"}}
    ],
    "links": [
      {"from": "data_input",  "to": "data_split",  "from_pin": 0, "to_pin": 0},
      {"from": "data_input",  "to": "data_split",  "from_pin": 1, "to_pin": 1},
      {"from": "data_split",  "to": "data_loader", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "normalize",   "from_pin": 0, "to_pin": 0},
      {"from": "normalize",   "to": "fc1",         "from_pin": 0, "to_pin": 0},
      {"from": "fc1",         "to": "relu1",       "from_pin": 0, "to_pin": 0},
      {"from": "relu1",       "to": "fc2",         "from_pin": 0, "to_pin": 0},
      {"from": "fc2",         "to": "relu2",       "from_pin": 0, "to_pin": 0},
      {"from": "relu2",       "to": "fc3",         "from_pin": 0, "to_pin": 0},
      {"from": "data_input",  "to": "loss",        "from_pin": 1, "to_pin": 0},
      {"from": "data_input",  "to": "loss",        "from_pin": 1, "to_pin": 1},
      {"from": "loss",        "to": "optimizer",   "from_pin": 0, "to_pin": 0},
      {"from": "optimizer",   "to": "output",      "from_pin": 0, "to_pin": 0}
    ]
  }
}
