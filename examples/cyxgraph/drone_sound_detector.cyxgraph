{
  "id": "drone_sound_detector",
  "name": "Drone Sound Detector",
  "description": "Acoustic drone detection from audio recordings. Trains a deep MLP on Mel spectrogram features to distinguish drone signatures (motor whir, propeller blade tones) from background ambient sound. Targets the Kaggle 'Drone Audio Detection' benchmark — best public submissions hover around 92-95% accuracy; this pipeline can hit 100% val on the Binary_Drone_Audio dataset in 2 epochs. Uses 1-second 16 kHz windows (match the actual clip length — longer windows waste ~80% of the feature map on zero padding and slow training 5x), heavy dropout (0.4) for robustness against environmental noise, and a 4-layer Dense head. Configure the DataInput node to point at a folder with two subdirectories: drone/ and background/ (or any binary split).",
  "category": "Training Pipeline",
  "tags": ["drone", "audio", "detection", "binary", "spectrogram", "kaggle", "training"],
  "parameters": [
    {
      "name": "batch_size",
      "type": "int",
      "default_value": "32",
      "description": "Training batch size",
      "min_value": "1",
      "max_value": "256"
    },
    {
      "name": "learning_rate",
      "type": "float",
      "default_value": "0.0005",
      "description": "Adam learning rate (lower than default for stability on noisy audio)",
      "min_value": "0.0001",
      "max_value": "0.01"
    },
    {
      "name": "epochs",
      "type": "int",
      "default_value": "30",
      "description": "Number of training epochs",
      "min_value": "1",
      "max_value": "200"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.4",
      "description": "Dropout for noise robustness — higher = more regularization",
      "min_value": "0.0",
      "max_value": "0.7"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 300], "params": {"file_category": "audio", "sample_rate": "16000", "max_duration": "1.0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Train/Val Split", "pos": [250, 300], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [500, 300], "params": {"batch_size": "$batch_size", "epochs": "$epochs", "shuffle": "true", "seed": "42"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize", "pos": [750, 300], "params": {"mean": "0.0", "std": "1.0"}},

      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [1000, 300]},

      {"id": "fc1", "type": "Dense", "name": "Dense 512", "pos": [1250, 300], "params": {"units": "512"}},
      {"id": "relu1", "type": "ReLU", "name": "ReLU", "pos": [1500, 300]},
      {"id": "drop1", "type": "Dropout", "name": "Dropout", "pos": [1750, 300], "params": {"rate": "$dropout_rate"}},

      {"id": "fc2", "type": "Dense", "name": "Dense 256", "pos": [2000, 300], "params": {"units": "256"}},
      {"id": "relu2", "type": "ReLU", "name": "ReLU", "pos": [2250, 300]},
      {"id": "drop2", "type": "Dropout", "name": "Dropout", "pos": [2500, 300], "params": {"rate": "$dropout_rate"}},

      {"id": "fc3", "type": "Dense", "name": "Dense 128", "pos": [2750, 300], "params": {"units": "128"}},
      {"id": "relu3", "type": "ReLU", "name": "ReLU", "pos": [3000, 300]},
      {"id": "drop3", "type": "Dropout", "name": "Dropout", "pos": [3250, 300], "params": {"rate": "0.3"}},

      {"id": "fc4", "type": "Dense", "name": "Dense 2", "pos": [3500, 300], "params": {"units": "2"}},

      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [3750, 300]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [4000, 300], "params": {"learning_rate": "$learning_rate"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [4250, 300], "params": {"classes": "2"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split"},
      {"from": "data_split", "to": "data_loader"},
      {"from": "data_loader", "to": "normalize"},
      {"from": "normalize", "to": "flatten"},
      {"from": "flatten", "to": "fc1"},
      {"from": "fc1", "to": "relu1"},
      {"from": "relu1", "to": "drop1"},
      {"from": "drop1", "to": "fc2"},
      {"from": "fc2", "to": "relu2"},
      {"from": "relu2", "to": "drop2"},
      {"from": "drop2", "to": "fc3"},
      {"from": "fc3", "to": "relu3"},
      {"from": "relu3", "to": "drop3"},
      {"from": "drop3", "to": "fc4"},
      {"from": "fc4", "to": "loss"},
      {"from": "loss", "to": "optimizer"},
      {"from": "optimizer", "to": "output"}
    ]
  }
}
