{
  "id": "text_test_01_sentiment_basic",
  "name": "Text Test 1 - Sentiment Classification (Basic)",
  "description": "Text pipeline smoke test: Data Input (text and label) -> Text Tokenizer (word ids, 128 per statement) -> Data Split -> DataLoader -> a dense classifier, with loss targets from DataLoader.Labels. Target dataset: D:/demo/mrcj/datasets/sentiment analysis/sentiment_mental_health.csv with statement as text and status as label.",
  "category": "Training Pipeline",
  "tags": [
    "text",
    "sentiment",
    "test",
    "phase3",
    "classification",
    "training"
  ],
  "parameters": [
    {
      "name": "batch_size",
      "type": "int",
      "default_value": "64",
      "description": "Training batch size",
      "min_value": "1",
      "max_value": "512"
    },
    {
      "name": "learning_rate",
      "type": "float",
      "default_value": "0.001",
      "description": "Adam learning rate",
      "min_value": "0.0001",
      "max_value": "0.01"
    },
    {
      "name": "epochs",
      "type": "int",
      "default_value": "5",
      "description": "Number of training epochs",
      "min_value": "1",
      "max_value": "100"
    }
  ],
  "template": {
    "nodes": [
      {
        "id": "data_input",
        "type": "DataInput",
        "name": "Data Input",
        "pos": [
          0,
          300
        ],
        "params": {
          "file_category": "text",
          "text_column": "statement",
          "text_label_column": "status"
        }
      },
      {
        "id": "text_tokenizer",
        "type": "TextTokenizer",
        "name": "Tokenizer (word)",
        "pos": [
          250,
          300
        ],
        "params": {
          "text_col": "statement",
          "label_col": "status",
          "pad_value": "0",
          "tokenizer_type": "1",
          "max_length": "128",
          "lowercase": "true",
          "min_word_freq": "2"
        }
      },
      {
        "id": "data_split",
        "type": "DataSplit",
        "name": "Train/Val Split",
        "pos": [
          500,
          300
        ],
        "params": {
          "train_ratio": "0.8",
          "val_ratio": "0.1",
          "test_ratio": "0.1"
        }
      },
      {
        "id": "data_loader",
        "type": "DataLoader",
        "name": "DataLoader",
        "pos": [
          750,
          300
        ],
        "params": {
          "batch_size": "$batch_size",
          "epochs": "$epochs",
          "shuffle": "true",
          "seed": "42"
        }
      },
      {
        "id": "normalize",
        "type": "Normalize",
        "name": "Normalize",
        "pos": [
          1000,
          300
        ],
        "params": {
          "mean": "0.0",
          "std": "1.0"
        }
      },
      {
        "id": "flatten",
        "type": "Flatten",
        "name": "Flatten",
        "pos": [
          1250,
          300
        ]
      },
      {
        "id": "fc1",
        "type": "Dense",
        "name": "Dense 256",
        "pos": [
          1500,
          300
        ],
        "params": {
          "units": "256"
        }
      },
      {
        "id": "relu1",
        "type": "ReLU",
        "name": "ReLU",
        "pos": [
          1750,
          300
        ]
      },
      {
        "id": "drop1",
        "type": "Dropout",
        "name": "Dropout 0.3",
        "pos": [
          2000,
          300
        ],
        "params": {
          "rate": "0.3"
        }
      },
      {
        "id": "fc2",
        "type": "Dense",
        "name": "Dense 64",
        "pos": [
          2250,
          300
        ],
        "params": {
          "units": "64"
        }
      },
      {
        "id": "relu2",
        "type": "ReLU",
        "name": "ReLU",
        "pos": [
          2500,
          300
        ]
      },
      {
        "id": "fc3",
        "type": "Dense",
        "name": "Dense (classes)",
        "pos": [
          2750,
          300
        ],
        "params": {
          "units": "7"
        }
      },
      {
        "id": "loss",
        "type": "CrossEntropyLoss",
        "name": "CrossEntropy",
        "pos": [
          3000,
          300
        ]
      },
      {
        "id": "optimizer",
        "type": "Adam",
        "name": "Adam",
        "pos": [
          3250,
          300
        ],
        "params": {
          "learning_rate": "$learning_rate"
        }
      },
      {
        "id": "output",
        "type": "Output",
        "name": "Output",
        "pos": [
          3500,
          300
        ],
        "params": {
          "num_classes": "7"
        }
      }
    ],
    "links": [
      {
        "from": "data_input",
        "to": "text_tokenizer",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "text_tokenizer",
        "to": "data_split",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "data_split",
        "to": "data_loader",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "data_loader",
        "to": "normalize",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "normalize",
        "to": "flatten",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "flatten",
        "to": "fc1",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "fc1",
        "to": "relu1",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "relu1",
        "to": "drop1",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "drop1",
        "to": "fc2",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "fc2",
        "to": "relu2",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "relu2",
        "to": "fc3",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "fc3",
        "to": "loss",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "data_loader",
        "to": "loss",
        "from_pin": 1,
        "to_pin": 1
      },
      {
        "from": "loss",
        "to": "optimizer",
        "from_pin": 0,
        "to_pin": 0
      },
      {
        "from": "optimizer",
        "to": "output",
        "from_pin": 0,
        "to_pin": 0
      }
    ]
  }
}
