{
  "id": "codefeedback_lang_classifier_text",
  "name": "CodeFeedback Lang Classifier - Small Text Demo",
  "description": "Supported CyxWiz text demo for the CodeFeedback blobs. This is not a transformer LLM. It is the smallest reproducible text model path the engine supports today: whitespace tokenizer, fixed vocab file, Embedding -> GRU -> Dense classifier. The point is to show how to train and test a real text model on the dataset while the true LLM/transformer path is still missing in the backend. The demo is intended to be rebuilt as a binary python-vs-cpp classifier.",
  "category": "Training Pipeline",
  "tags": ["text", "nlp", "code", "classification", "demo", "gru"],
  "parameters": [
    {
      "name": "batch_size",
      "type": "int",
      "default_value": "32",
      "description": "Training batch size",
      "min_value": "1",
      "max_value": "256"
    },
    {
      "name": "learning_rate",
      "type": "float",
      "default_value": "0.001",
      "description": "Adam learning rate",
      "min_value": "0.00001",
      "max_value": "0.01"
    },
    {
      "name": "epochs",
      "type": "int",
      "default_value": "5",
      "description": "Number of training epochs",
      "min_value": "1",
      "max_value": "50"
    },
    {
      "name": "max_length",
      "type": "int",
      "default_value": "192",
      "description": "Max tokens per sample",
      "min_value": "32",
      "max_value": "512"
    },
    {
      "name": "embedding_dim",
      "type": "int",
      "default_value": "64",
      "description": "Embedding dimension",
      "min_value": "8",
      "max_value": "256"
    },
    {
      "name": "hidden_size",
      "type": "int",
      "default_value": "96",
      "description": "GRU hidden size",
      "min_value": "8",
      "max_value": "512"
    },
    {
      "name": "vocab_size",
      "type": "int",
      "default_value": "12000",
      "description": "Vocabulary cap including special tokens",
      "min_value": "100",
      "max_value": "50000"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.3",
      "description": "Dropout rate on the classifier head",
      "min_value": "0.0",
      "max_value": "0.7"
    }
  ],
  "template": {
    "nodes": [
      {
        "id": "data_input",
        "type": "DataInput",
        "name": "Data Input",
        "pos": [0, 300],
        "params": {
          "source_type": "file",
          "file_category": "text",
          "file_path": "D:/Dev/DataSet_List/datasets--m-a-p--CodeFeedback-Filtered-Instruction/data/codefeedback_lang_binary.csv",
          "text_column": "text",
          "text_label_column": "label",
          "text_tokenizer_type": "0",
          "text_max_length": "$max_length",
          "text_lowercase": "true",
          "text_min_freq": "1",
          "text_max_vocab_size": "$vocab_size"
        }
      },
      {
        "id": "text_tokenizer",
        "type": "TextTokenizer",
        "name": "Tokenizer (whitespace)",
        "pos": [250, 300],
        "params": {
          "tokenizer_type": "0",
          "max_length": "$max_length",
          "lowercase": "true",
          "min_freq": "1",
          "max_vocab_size": "$vocab_size"
        }
      },
      {
        "id": "text_vocab",
        "type": "TextVocabulary",
        "name": "Vocabulary",
        "pos": [500, 300],
        "params": {
          "min_freq": "1",
          "max_vocab_size": "$vocab_size",
          "vocab_file": "D:/Dev/DataSet_List/datasets--m-a-p--CodeFeedback-Filtered-Instruction/data/codefeedback_vocab.txt"
        }
      },
      {
        "id": "text_padding",
        "type": "TextPadding",
        "name": "Padding",
        "pos": [750, 300],
        "params": {
          "max_length": "$max_length",
          "pad_value": "0"
        }
      },
      {
        "id": "data_split",
        "type": "DataSplit",
        "name": "Split 80/10/10",
        "pos": [1000, 300],
        "params": {
          "train_ratio": "0.8",
          "val_ratio": "0.1",
          "test_ratio": "0.1",
          "stratified": "true",
          "seed": "42"
        }
      },
      {
        "id": "data_loader",
        "type": "DataLoader",
        "name": "DataLoader",
        "pos": [1250, 300],
        "params": {
          "batch_size": "$batch_size",
          "epochs": "$epochs",
          "shuffle": "true",
          "seed": "42",
          "validation_freq": "1"
        }
      },
      {
        "id": "embedding",
        "type": "Embedding",
        "name": "Embedding",
        "pos": [1500, 300],
        "params": {
          "num_embeddings": "$vocab_size",
          "embedding_dim": "$embedding_dim",
          "padding_idx": "0"
        }
      },
      {
        "id": "gru",
        "type": "GRU",
        "name": "GRU",
        "pos": [1750, 300],
        "params": {
          "hidden_size": "$hidden_size",
          "num_layers": "1",
          "bidirectional": "false",
          "return_sequences": "false"
        }
      },
      {
        "id": "fc1",
        "type": "Dense",
        "name": "Dense 64",
        "pos": [2000, 300],
        "params": {
          "units": "64"
        }
      },
      {
        "id": "relu1",
        "type": "ReLU",
        "name": "ReLU",
        "pos": [2250, 300]
      },
      {
        "id": "drop1",
        "type": "Dropout",
        "name": "Dropout",
        "pos": [2500, 300],
        "params": {
          "rate": "$dropout_rate"
        }
      },
      {
        "id": "fc_out",
        "type": "Dense",
        "name": "Dense 2",
        "pos": [2750, 300],
        "params": {
          "units": "2"
        }
      },
      {
        "id": "loss",
        "type": "CrossEntropyLoss",
        "name": "CrossEntropy",
        "pos": [3000, 300]
      },
      {
        "id": "optimizer",
        "type": "Adam",
        "name": "Adam",
        "pos": [3250, 300],
        "params": {
          "learning_rate": "$learning_rate"
        }
      },
      {
        "id": "output",
        "type": "Output",
        "name": "Output",
        "pos": [3500, 300],
        "params": {
          "classes": "2"
        }
      }
    ],
    "links": [
      {"from": "data_input", "to": "text_tokenizer"},
      {"from": "text_tokenizer", "to": "text_vocab"},
      {"from": "text_vocab", "to": "text_padding"},
      {"from": "text_padding", "to": "data_split"},
      {"from": "data_split", "to": "data_loader"},
      {"from": "data_loader", "to": "embedding"},
      {"from": "embedding", "to": "gru"},
      {"from": "gru", "to": "fc1"},
      {"from": "fc1", "to": "relu1"},
      {"from": "relu1", "to": "drop1"},
      {"from": "drop1", "to": "fc_out"},
      {"from": "fc_out", "to": "loss"},
      {"from": "loss", "to": "optimizer"},
      {"from": "optimizer", "to": "output"}
    ]
  }
}
