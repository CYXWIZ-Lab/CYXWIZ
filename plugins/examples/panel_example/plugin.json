{
    "id": "com.cyxwiz.examples.panel",
    "name": "Example Panel",
    "version": "1.0.0",
    "api_version": "1.4.0",
    "description": "A panel drawn by a plugin built from the installed SDK: a damped spring with typed fields and a plot",
    "author": "CyxWiz Lab",
    "license": "MIT",
    "homepage": "https://github.com/CYXWIZ-Lab/CYXWIZ",
    "capabilities": ["ProvidesPanels"],
    "permissions": ["UIModify"],
    "platforms": {
        "windows": { "library": "bin/panel_example.dll" },
        "linux": { "library": "bin/libpanel_example.so" },
        "macos": { "library": "bin/libpanel_example.dylib" }
    }
}
