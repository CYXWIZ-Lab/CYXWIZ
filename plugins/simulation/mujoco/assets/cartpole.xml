<mujoco model="cartpole">
  <option timestep="0.02" integrator="RK4"/>

  <default>
    <joint damping="0.05"/>
    <geom contype="0" conaffinity="0" rgba="0.7 0.3 0.3 1"/>
  </default>

  <worldbody>
    <light diffuse="0.8 0.8 0.8" pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="5 5 0.1" rgba="0.9 0.9 0.9 1"/>

    <!-- Cart -->
    <body name="cart" pos="0 0 0.5">
      <joint name="slider" type="slide" axis="1 0 0" range="-2.4 2.4"/>
      <geom type="box" size="0.2 0.15 0.1" mass="1.0" rgba="0.3 0.5 0.8 1"/>

      <!-- Pole -->
      <body name="pole" pos="0 0 0.1">
        <joint name="hinge" type="hinge" axis="0 1 0"/>
        <geom type="capsule" fromto="0 0 0  0 0 0.6" size="0.04" mass="0.1" rgba="0.8 0.6 0.2 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="slider" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
