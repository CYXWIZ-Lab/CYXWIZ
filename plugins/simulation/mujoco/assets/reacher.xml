<mujoco model="reacher">
  <option timestep="0.02" gravity="0 0 0"/>

  <default>
    <joint damping="0.1" limited="true"/>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light diffuse="0.8 0.8 0.8" pos="0 0 2" dir="0 0 -1"/>
    <geom type="plane" size="1 1 0.01" rgba="0.9 0.9 0.9 1"/>

    <!-- Base pivot -->
    <body name="body0" pos="0 0 0.01">
      <joint name="joint0" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
      <geom type="capsule" fromto="0 0 0  0.1 0 0" size="0.01" mass="0.1" rgba="0.3 0.6 0.3 1"/>

      <!-- Second link -->
      <body name="body1" pos="0.1 0 0">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom type="capsule" fromto="0 0 0  0.1 0 0" size="0.01" mass="0.1" rgba="0.3 0.3 0.6 1"/>

        <!-- Fingertip -->
        <body name="fingertip" pos="0.1 0 0">
          <geom name="fingertip" type="sphere" size="0.01" rgba="0.8 0.2 0.2 1"/>
        </body>
      </body>
    </body>

    <!-- Target (fixed, repositioned programmatically) -->
    <body name="target" pos="0.1 0.1 0.01">
      <geom name="target" type="sphere" size="0.015" rgba="0.2 0.8 0.2 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor joint="joint0" gear="1" ctrlrange="-1 1" ctrllimited="true"/>
    <motor joint="joint1" gear="1" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
