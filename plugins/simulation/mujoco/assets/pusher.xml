<mujoco model="pusher">
  <option timestep="0.02" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.5" limited="true"/>
    <geom contype="1" conaffinity="1" condim="3" friction="1.0 0.5 0.5"/>
  </default>

  <worldbody>
    <light diffuse="0.8 0.8 0.8" pos="0 0 2" dir="0 0 -1"/>
    <geom type="plane" size="2 2 0.01" rgba="0.9 0.9 0.9 1"/>

    <!-- Robot arm base -->
    <body name="base" pos="0 0 0.02">
      <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>

      <!-- Link 1 -->
      <body name="link1" pos="0 0 0.02">
        <joint name="joint0" type="hinge" axis="0 0 1" range="-2.3 2.3"/>
        <geom type="capsule" fromto="0 0 0  0.1 0 0" size="0.02" mass="0.5" rgba="0.4 0.6 0.4 1"/>

        <!-- Link 2 -->
        <body name="link2" pos="0.1 0 0">
          <joint name="joint1" type="hinge" axis="0 0 1" range="-2.3 2.3"/>
          <geom type="capsule" fromto="0 0 0  0.1 0 0" size="0.02" mass="0.5" rgba="0.4 0.4 0.6 1"/>

          <!-- Link 3 -->
          <body name="link3" pos="0.1 0 0">
            <joint name="joint2" type="hinge" axis="0 0 1" range="-2.3 2.3"/>
            <geom type="capsule" fromto="0 0 0  0.06 0 0" size="0.02" mass="0.3" rgba="0.6 0.4 0.4 1"/>

            <!-- Fingertip -->
            <body name="fingertip" pos="0.06 0 0">
              <geom name="fingertip" type="sphere" size="0.02" rgba="0.9 0.2 0.2 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Object to push -->
    <body name="object" pos="0.2 0.1 0.02">
      <joint name="obj_slidex" type="slide" axis="1 0 0" limited="false"/>
      <joint name="obj_slidey" type="slide" axis="0 1 0" limited="false"/>
      <geom name="object" type="cylinder" size="0.02 0.02" mass="0.1" rgba="0.2 0.6 0.9 1"/>
    </body>

    <!-- Target position -->
    <body name="target" pos="0.15 -0.1 0.01">
      <geom name="target" type="cylinder" size="0.025 0.005" rgba="0.2 0.9 0.2 0.5" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor joint="joint0" gear="50" ctrlrange="-2 2" ctrllimited="true"/>
    <motor joint="joint1" gear="50" ctrlrange="-2 2" ctrllimited="true"/>
    <motor joint="joint2" gear="50" ctrlrange="-2 2" ctrllimited="true"/>
    <motor joint="obj_slidex" gear="20" ctrlrange="-1 1" ctrllimited="true"/>
    <motor joint="obj_slidey" gear="20" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
