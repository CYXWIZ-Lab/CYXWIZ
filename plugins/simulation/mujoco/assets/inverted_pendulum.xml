<!-- Inverted Pendulum — simplest MuJoCo RL environment
     A cart on a rail with a pole attached by a hinge joint.
     Goal: Keep the pole balanced upright.

     Source: Gymnasium MuJoCo assets (Apache 2.0)
     https://github.com/Farama-Foundation/Gymnasium/blob/main/gymnasium/envs/mujoco/assets/inverted_pendulum.xml
-->
<mujoco model="inverted pendulum">
  <compiler angle="radian" inertiafromgeom="true"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.15 0.15 0.15" specular="0.3 0.3 0.3"/>
    <quality shadowsize="2048"/>
  </visual>
  <default>
    <joint armature="0" damping="1" limited="true"/>
    <geom contype="0" friction="1 0.1 0.1" rgba="0.7 0.7 0 1"/>
  </default>
  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.02"/>
  <size nstack="3000"/>

  <worldbody>
    <light diffuse=".8 .8 .8" specular=".3 .3 .3" pos="0 0 4" dir="0 0 -1"/>
    <light diffuse=".4 .4 .4" pos="2 2 3" dir="-1 -1 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.4 0.4 0.5 1"
          conaffinity="1" condim="3"/>
    <geom name="rail" pos="0 0 0" quat="0.707 0 0.707 0"
          rgba="0.3 0.3 0.7 1" size="0.02 1" type="capsule"/>
    <body name="cart" pos="0 0 0">
      <joint axis="1 0 0" limited="true" name="slider" pos="0 0 0"
             range="-1 1" type="slide"/>
      <geom name="cart" pos="0 0 0" quat="0.707 0 0.707 0"
            size="0.1 0.1" type="capsule"/>
      <body name="pole" pos="0 0 0">
        <joint axis="0 1 0" name="hinge" pos="0 0 0" range="-0.2 0.2"/>
        <geom fromto="0 0 0 0.001 0 0.6" name="cpole" rgba="0 0.7 0.7 1"
              size="0.049 0.3" type="capsule"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor ctrllimited="true" ctrlrange="-3 3" gear="100"
           joint="slider" name="slide"/>
  </actuator>
</mujoco>
