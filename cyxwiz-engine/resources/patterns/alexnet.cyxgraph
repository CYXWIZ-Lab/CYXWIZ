{
  "id": "alexnet",
  "name": "AlexNet",
  "kind": "graph",
  "description": "AlexNet (Krizhevsky et al. 2012): five Conv2D layers with MaxPool and three Dense layers with Dropout. Expects an image folder with one subfolder per class (resized to 256, centre 224 x 224, ImageNet statistics). Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[224, 224, 3]",
  "category": "CNN",
  "tags": ["alexnet", "imagenet", "classic", "deep-learning", "cnn", "historical"],
  "parameters": [
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "1000",
      "description": "Number of output classes (1000 for ImageNet)",
      "min_value": "2",
      "max_value": "10000"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.5",
      "description": "Dropout rate for FC layers",
      "min_value": "0.0",
      "max_value": "0.7"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 260], "params": {"source_type": "folder", "file_category": "image", "image_layout": "1"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [220, 260], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [440, 260], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "resize", "type": "Resize", "name": "Resize 256", "pos": [660, 260], "params": {"width": "256", "height": "256", "mode": "exact"}},
      {"id": "center_crop", "type": "CenterCrop", "name": "Center Crop 224", "pos": [880, 260], "params": {"width": "224", "height": "224"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize (ImageNet)", "pos": [1100, 260], "params": {"statistics": "imagenet"}},
      {"id": "conv1", "type": "Conv2D", "name": "Conv1 11x11/4", "pos": [1520, 260], "params": {"filters": "96", "kernel_size": "11", "stride": "4", "padding": "valid"}},
      {"id": "act1", "type": "ReLU", "name": "ReLU 1", "pos": [1720, 260]},
      {"id": "pool1", "type": "MaxPool2D", "name": "MaxPool 3x3/2", "pos": [1920, 260], "params": {"pool_size": "3", "stride": "2"}},
      {"id": "conv2", "type": "Conv2D", "name": "Conv2 5x5", "pos": [2120, 260], "params": {"filters": "256", "kernel_size": "5", "padding": "same"}},
      {"id": "act2", "type": "ReLU", "name": "ReLU 2", "pos": [2320, 260]},
      {"id": "pool2", "type": "MaxPool2D", "name": "MaxPool 3x3/2", "pos": [2520, 260], "params": {"pool_size": "3", "stride": "2"}},
      {"id": "conv3", "type": "Conv2D", "name": "Conv3 3x3", "pos": [2720, 260], "params": {"filters": "384", "kernel_size": "3", "padding": "same"}},
      {"id": "act3", "type": "ReLU", "name": "ReLU 3", "pos": [2920, 260]},
      {"id": "conv4", "type": "Conv2D", "name": "Conv4 3x3", "pos": [3120, 260], "params": {"filters": "384", "kernel_size": "3", "padding": "same"}},
      {"id": "act4", "type": "ReLU", "name": "ReLU 4", "pos": [3320, 260]},
      {"id": "conv5", "type": "Conv2D", "name": "Conv5 3x3", "pos": [3520, 260], "params": {"filters": "256", "kernel_size": "3", "padding": "same"}},
      {"id": "act5", "type": "ReLU", "name": "ReLU 5", "pos": [3720, 260]},
      {"id": "pool3", "type": "MaxPool2D", "name": "MaxPool 3x3/2", "pos": [3920, 260], "params": {"pool_size": "3", "stride": "2"}},
      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [1320, 460]},
      {"id": "fc1", "type": "Dense", "name": "FC1 4096", "pos": [1520, 460], "params": {"units": "4096"}},
      {"id": "act6", "type": "ReLU", "name": "ReLU 6", "pos": [1720, 460]},
      {"id": "dropout1", "type": "Dropout", "name": "Dropout 1", "pos": [1920, 460], "params": {"rate": "$dropout_rate"}},
      {"id": "fc2", "type": "Dense", "name": "FC2 4096", "pos": [2120, 460], "params": {"units": "4096"}},
      {"id": "act7", "type": "ReLU", "name": "ReLU 7", "pos": [2320, 460]},
      {"id": "dropout2", "type": "Dropout", "name": "Dropout 2", "pos": [2520, 460], "params": {"rate": "$dropout_rate"}},
      {"id": "fc3", "type": "Dense", "name": "FC3 Output", "pos": [2720, 460], "params": {"units": "$num_classes"}},
      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [4140, 320]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [4360, 320], "params": {"learning_rate": "0.001", "beta1": "0.9", "beta2": "0.999", "epsilon": "1e-8"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [4580, 320], "params": {"num_classes": "$num_classes"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split", "from_pin": 0, "to_pin": 0},
      {"from": "data_split", "to": "data_loader", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "resize", "from_pin": 0, "to_pin": 0},
      {"from": "resize", "to": "center_crop", "from_pin": 0, "to_pin": 0},
      {"from": "center_crop", "to": "normalize", "from_pin": 0, "to_pin": 0},
      {"from": "normalize", "to": "conv1", "from_pin": 0, "to_pin": 0},
      {"from": "conv1", "to": "act1"},
      {"from": "act1", "to": "pool1"},
      {"from": "pool1", "to": "conv2"},
      {"from": "conv2", "to": "act2"},
      {"from": "act2", "to": "pool2"},
      {"from": "pool2", "to": "conv3"},
      {"from": "conv3", "to": "act3"},
      {"from": "act3", "to": "conv4"},
      {"from": "conv4", "to": "act4"},
      {"from": "act4", "to": "conv5"},
      {"from": "conv5", "to": "act5"},
      {"from": "act5", "to": "pool3"},
      {"from": "pool3", "to": "flatten"},
      {"from": "flatten", "to": "fc1"},
      {"from": "fc1", "to": "act6"},
      {"from": "act6", "to": "dropout1"},
      {"from": "dropout1", "to": "fc2"},
      {"from": "fc2", "to": "act7"},
      {"from": "act7", "to": "dropout2"},
      {"from": "dropout2", "to": "fc3"},
      {"from": "fc3", "to": "loss", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "loss", "from_pin": 1, "to_pin": 1},
      {"from": "loss", "to": "optimizer", "from_pin": 0, "to_pin": 0},
      {"from": "optimizer", "to": "output", "from_pin": 0, "to_pin": 0}
    ]
  }
}
