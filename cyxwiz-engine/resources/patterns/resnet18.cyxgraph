{
  "id": "resnet18",
  "name": "ResNet-18",
  "kind": "graph",
  "description": "ResNet-18 (He et al. 2015) exactly as torchvision builds it: a 7 x 7 stem, four stages of two residual blocks (64 to 512 channels), Global Avg Pool, a Dense head. Expects an image folder with one subfolder per class (resized to 256, centre 224 x 224, ImageNet statistics). Every layer is named as torchvision names it (41 layers with weights), so torchvision's ImageNet weights fill it: download resnet18-f37072fd.pth (https://download.pytorch.org/models/resnet18-f37072fd.pth), double-click DataLoader, Checkpoints tab, Start from: A weights file. With num_classes other than 1000 the last layer (fc) starts fresh; turn on freeze_backbone to train only it. Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[224, 224, 3]",
  "category": "CNN",
  "tags": ["resnet", "resnet18", "residual", "pretrained", "imagenet", "torchvision"],
  "parameters": [
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "1000",
      "description": "Number of output classes (1000 keeps the ImageNet head)",
      "min_value": "2",
      "max_value": "10000"
    },
    {
      "name": "freeze_backbone",
      "type": "bool",
      "default_value": "false",
      "description": "Freeze every layer with weights except the head (fc)"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0.0, 260.0], "params": {"source_type": "folder", "file_category": "image", "image_layout": "1"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [220.0, 260.0], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [440.0, 260.0], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "resize", "type": "Resize", "name": "Resize 256", "pos": [660.0, 260.0], "params": {"width": "256", "height": "256", "mode": "exact"}},
      {"id": "center_crop", "type": "CenterCrop", "name": "Center Crop 224", "pos": [880.0, 260.0], "params": {"width": "224", "height": "224"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize (ImageNet)", "pos": [1100.0, 260.0], "params": {"statistics": "imagenet"}},
      {"id": "conv1", "type": "Conv2D", "name": "conv1", "pos": [160.0, 460.0], "params": {"filters": "64", "kernel_size": "7", "stride": "2", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "bn1", "type": "BatchNorm", "name": "bn1", "pos": [380.0, 460.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "relu", "type": "ReLU", "name": "relu", "pos": [600.0, 460.0]},
      {"id": "maxpool", "type": "MaxPool2D", "name": "maxpool", "pos": [820.0, 460.0], "params": {"pool_size": "3", "stride": "2", "padding": "1"}},
      {"id": "layer1_0_conv1", "type": "Conv2D", "name": "layer1.0.conv1", "pos": [160.0, 660.0], "params": {"filters": "64", "kernel_size": "3", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "layer1_0_bn1", "type": "BatchNorm", "name": "layer1.0.bn1", "pos": [380.0, 660.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "layer1_0_relu", "type": "ReLU", "name": "layer1.0.relu", "pos": [600.0, 660.0]},
      {"id": "layer1_0_conv2", "type": "Conv2D", "name": "layer1.0.conv2", "pos": [820.0, 660.0], "params": {"filters": "64", "kernel_size": "3", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "layer1_0_bn2", "type": "BatchNorm", "name": "layer1.0.bn2", "pos": [1040.0, 660.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "layer1_0_add", "type": "Add", "name": "layer1.0.add", "pos": [1260.0, 660.0]},
      {"id": "layer1_0_relu_1", "type": "ReLU", "name": "layer1.0.relu_1", "pos": [1480.0, 660.0]},
      {"id": "layer1_1_conv1", "type": "Conv2D", "name": "layer1.1.conv1", "pos": [160.0, 860.0], "params": {"filters": "64", "kernel_size": "3", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "layer1_1_bn1", "type": "BatchNorm", "name": "layer1.1.bn1", "pos": [380.0, 860.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "layer1_1_relu", "type": "ReLU", "name": "layer1.1.relu", "pos": [600.0, 860.0]},
      {"id": "layer1_1_conv2", "type": "Conv2D", "name": "layer1.1.conv2", "pos": [820.0, 860.0], "params": {"filters": "64", "kernel_size": "3", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "layer1_1_bn2", "type": "BatchNorm", "name": "layer1.1.bn2", "pos": [1040.0, 860.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "layer1_1_add", "type": "Add", "name": "layer1.1.add", "pos": [1260.0, 860.0]},
      {"id": "layer1_1_relu_1", "type": "ReLU", "name": "layer1.1.relu_1", "pos": [1480.0, 860.0]},
      {"id": "layer2_0_conv1", "type": "Conv2D", "name": "layer2.0.conv1", "pos": [160.0, 1060.0], "params": {"filters": "128", "kernel_size": "3", "stride": "2", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "layer2_0_bn1", "type": "BatchNorm", "name": "layer2.0.bn1", "pos": [380.0, 1060.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "layer2_0_relu", "type": "ReLU", "name": "layer2.0.relu", "pos": [600.0, 1060.0]},
      {"id": "layer2_0_conv2", "type": "Conv2D", "name": "layer2.0.conv2", "pos": [820.0, 1060.0], "params": {"filters": "128", "kernel_size": "3", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "layer2_0_bn2", "type": "BatchNorm", "name": "layer2.0.bn2", "pos": [1040.0, 1060.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "layer2_0_downsample_0", "type": "Conv2D", "name": "layer2.0.downsample.0", "pos": [1260.0, 1060.0], "params": {"filters": "128", "kernel_size": "1", "stride": "2", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "layer2_0_downsample_1", "type": "BatchNorm", "name": "layer2.0.downsample.1", "pos": [1480.0, 1060.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "layer2_0_add", "type": "Add", "name": "layer2.0.add", "pos": [1700.0, 1060.0]},
      {"id": "layer2_0_relu_1", "type": "ReLU", "name": "layer2.0.relu_1", "pos": [1920.0, 1060.0]},
      {"id": "layer2_1_conv1", "type": "Conv2D", "name": "layer2.1.conv1", "pos": [160.0, 1260.0], "params": {"filters": "128", "kernel_size": "3", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "layer2_1_bn1", "type": "BatchNorm", "name": "layer2.1.bn1", "pos": [380.0, 1260.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "layer2_1_relu", "type": "ReLU", "name": "layer2.1.relu", "pos": [600.0, 1260.0]},
      {"id": "layer2_1_conv2", "type": "Conv2D", "name": "layer2.1.conv2", "pos": [820.0, 1260.0], "params": {"filters": "128", "kernel_size": "3", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "layer2_1_bn2", "type": "BatchNorm", "name": "layer2.1.bn2", "pos": [1040.0, 1260.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "layer2_1_add", "type": "Add", "name": "layer2.1.add", "pos": [1260.0, 1260.0]},
