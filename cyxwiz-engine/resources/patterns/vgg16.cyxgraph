{
  "id": "vgg16",
  "name": "VGG-16",
  "kind": "graph",
  "description": "VGG-16 (Simonyan and Zisserman 2014): thirteen 3 x 3 Conv2D layers in five stages, three Dense layers. Expects an image folder with one subfolder per class (resized to 256, centre 224 x 224, ImageNet statistics). Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[224, 224, 3]",
  "category": "CNN",
  "tags": ["vgg", "vgg16", "imagenet", "deep", "cnn", "classic"],
  "parameters": [
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "1000",
      "description": "Number of output classes",
      "min_value": "2",
      "max_value": "10000"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.5",
      "description": "Dropout rate for FC layers",
      "min_value": "0.0",
      "max_value": "0.7"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 260], "params": {"source_type": "folder", "file_category": "image", "image_layout": "0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [220, 260], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [440, 260], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "resize", "type": "Resize", "name": "Resize 256", "pos": [660, 260], "params": {"width": "256", "height": "256", "mode": "exact"}},
      {"id": "center_crop", "type": "CenterCrop", "name": "Center Crop 224", "pos": [880, 260], "params": {"width": "224", "height": "224"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize (ImageNet)", "pos": [1100, 260], "params": {"statistics": "imagenet"}},
      {"id": "conv1_1", "type": "Conv2D", "name": "Conv1-1", "pos": [1470, 260], "params": {"filters": "64", "kernel_size": "3", "padding": "same"}},
      {"id": "act1_1", "type": "ReLU", "name": "ReLU", "pos": [1620, 260]},
      {"id": "conv1_2", "type": "Conv2D", "name": "Conv1-2", "pos": [1770, 260], "params": {"filters": "64", "kernel_size": "3", "padding": "same"}},
      {"id": "act1_2", "type": "ReLU", "name": "ReLU", "pos": [1920, 260]},
      {"id": "pool1", "type": "MaxPool2D", "name": "MaxPool", "pos": [2070, 260], "params": {"pool_size": "2", "stride": "2"}},
      {"id": "conv2_1", "type": "Conv2D", "name": "Conv2-1", "pos": [2220, 260], "params": {"filters": "128", "kernel_size": "3", "padding": "same"}},
      {"id": "act2_1", "type": "ReLU", "name": "ReLU", "pos": [2370, 260]},
      {"id": "conv2_2", "type": "Conv2D", "name": "Conv2-2", "pos": [2520, 260], "params": {"filters": "128", "kernel_size": "3", "padding": "same"}},
      {"id": "act2_2", "type": "ReLU", "name": "ReLU", "pos": [2670, 260]},
      {"id": "pool2", "type": "MaxPool2D", "name": "MaxPool", "pos": [2820, 260], "params": {"pool_size": "2", "stride": "2"}},
      {"id": "conv3_1", "type": "Conv2D", "name": "Conv3-1", "pos": [1320, 460], "params": {"filters": "256", "kernel_size": "3", "padding": "same"}},
      {"id": "act3_1", "type": "ReLU", "name": "ReLU", "pos": [1470, 460]},
      {"id": "conv3_2", "type": "Conv2D", "name": "Conv3-2", "pos": [1620, 460], "params": {"filters": "256", "kernel_size": "3", "padding": "same"}},
      {"id": "act3_2", "type": "ReLU", "name": "ReLU", "pos": [1770, 460]},
      {"id": "conv3_3", "type": "Conv2D", "name": "Conv3-3", "pos": [1920, 460], "params": {"filters": "256", "kernel_size": "3", "padding": "same"}},
      {"id": "act3_3", "type": "ReLU", "name": "ReLU", "pos": [2070, 460]},
      {"id": "pool3", "type": "MaxPool2D", "name": "MaxPool", "pos": [2220, 460], "params": {"pool_size": "2", "stride": "2"}},
      {"id": "conv4_1", "type": "Conv2D", "name": "Conv4-1", "pos": [2370, 460], "params": {"filters": "512", "kernel_size": "3", "padding": "same"}},
      {"id": "act4_1", "type": "ReLU", "name": "ReLU", "pos": [2520, 460]},
      {"id": "conv4_2", "type": "Conv2D", "name": "Conv4-2", "pos": [2670, 460], "params": {"filters": "512", "kernel_size": "3", "padding": "same"}},
      {"id": "act4_2", "type": "ReLU", "name": "ReLU", "pos": [2820, 460]},
      {"id": "conv4_3", "type": "Conv2D", "name": "Conv4-3", "pos": [2970, 460], "params": {"filters": "512", "kernel_size": "3", "padding": "same"}},
      {"id": "act4_3", "type": "ReLU", "name": "ReLU", "pos": [3120, 460]},
      {"id": "pool4", "type": "MaxPool2D", "name": "MaxPool", "pos": [3270, 460], "params": {"pool_size": "2", "stride": "2"}},
      {"id": "conv5_1", "type": "Conv2D", "name": "Conv5-1", "pos": [1320, 660], "params": {"filters": "512", "kernel_size": "3", "padding": "same"}},
      {"id": "act5_1", "type": "ReLU", "name": "ReLU", "pos": [1470, 660]},
      {"id": "conv5_2", "type": "Conv2D", "name": "Conv5-2", "pos": [1620, 660], "params": {"filters": "512", "kernel_size": "3", "padding": "same"}},
      {"id": "act5_2", "type": "ReLU", "name": "ReLU", "pos": [1770, 660]},
      {"id": "conv5_3", "type": "Conv2D", "name": "Conv5-3", "pos": [1920, 660], "params": {"filters": "512", "kernel_size": "3", "padding": "same"}},
      {"id": "act5_3", "type": "ReLU", "name": "ReLU", "pos": [2070, 660]},
      {"id": "pool5", "type": "MaxPool2D", "name": "MaxPool", "pos": [2220, 660], "params": {"pool_size": "2", "stride": "2"}},
      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [2370, 660]},
      {"id": "fc1", "type": "Dense", "name": "FC1 4096", "pos": [2520, 660], "params": {"units": "4096"}},
      {"id": "act_fc1", "type": "ReLU", "name": "ReLU", "pos": [2670, 660]},
      {"id": "dropout1", "type": "Dropout", "name": "Dropout", "pos": [2820, 660], "params": {"rate": "$dropout_rate"}},
      {"id": "fc2", "type": "Dense", "name": "FC2 4096", "pos": [2970, 660], "params": {"units": "4096"}},
      {"id": "act_fc2", "type": "ReLU", "name": "ReLU", "pos": [3120, 660]},
      {"id": "dropout2", "type": "Dropout", "name": "Dropout", "pos": [3270, 660], "params": {"rate": "$dropout_rate"}},
      {"id": "fc3", "type": "Dense", "name": "Output", "pos": [3420, 660], "params": {"units": "$num_classes"}},
      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [3640, 320]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [3860, 320], "params": {"learning_rate": "0.001", "beta1": "0.9", "beta2": "0.999", "epsilon": "1e-8"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [4080, 320], "params": {"num_classes": "$num_classes"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split", "from_pin": 0, "to_pin": 0},
      {"from": "data_split", "to": "data_loader", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "resize", "from_pin": 0, "to_pin": 0},
      {"from": "resize", "to": "center_crop", "from_pin": 0, "to_pin": 0},
      {"from": "center_crop", "to": "normalize", "from_pin": 0, "to_pin": 0},
      {"from": "normalize", "to": "conv1_1", "from_pin": 0, "to_pin": 0},
      {"from": "conv1_1", "to": "act1_1"},
      {"from": "act1_1", "to": "conv1_2"},
      {"from": "conv1_2", "to": "act1_2"},
      {"from": "act1_2", "to": "pool1"},
      {"from": "pool1", "to": "conv2_1"},
      {"from": "conv2_1", "to": "act2_1"},
      {"from": "act2_1", "to": "conv2_2"},
      {"from": "conv2_2", "to": "act2_2"},
      {"from": "act2_2", "to": "pool2"},
      {"from": "pool2", "to": "conv3_1"},
      {"from": "conv3_1", "to": "act3_1"},
      {"from": "act3_1", "to": "conv3_2"},
      {"from": "conv3_2", "to": "act3_2"},
      {"from": "act3_2", "to": "conv3_3"},
      {"from": "conv3_3", "to": "act3_3"},
      {"from": "act3_3", "to": "pool3"},
      {"from": "pool3", "to": "conv4_1"},
      {"from": "conv4_1", "to": "act4_1"},
      {"from": "act4_1", "to": "conv4_2"},
      {"from": "conv4_2", "to": "act4_2"},
      {"from": "act4_2", "to": "conv4_3"},
      {"from": "conv4_3", "to": "act4_3"},
      {"from": "act4_3", "to": "pool4"},
      {"from": "pool4", "to": "conv5_1"},
      {"from": "conv5_1", "to": "act5_1"},
      {"from": "act5_1", "to": "conv5_2"},
      {"from": "conv5_2", "to": "act5_2"},
      {"from": "act5_2", "to": "conv5_3"},
      {"from": "conv5_3", "to": "act5_3"},
      {"from": "act5_3", "to": "pool5"},
      {"from": "pool5", "to": "flatten"},
      {"from": "flatten", "to": "fc1"},
      {"from": "fc1", "to": "act_fc1"},
      {"from": "act_fc1", "to": "dropout1"},
      {"from": "dropout1", "to": "fc2"},
      {"from": "fc2", "to": "act_fc2"},
      {"from": "act_fc2", "to": "dropout2"},
      {"from": "dropout2", "to": "fc3"},
      {"from": "fc3", "to": "loss", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "loss", "from_pin": 1, "to_pin": 1},
      {"from": "loss", "to": "optimizer", "from_pin": 0, "to_pin": 0},
      {"from": "optimizer", "to": "output", "from_pin": 0, "to_pin": 0}
    ]
  }
}
