{
  "id": "ppo_mlp",
  "name": "PPO (MLP 64-64)",
  "description": "Proximal Policy Optimization as in Stable-Baselines3's MlpPolicy: an Environment, separate policy and value networks of two Dense layers with Tanh, a Policy Head and a Value Head that size their outputs from the environment, and PPO. Pick the environment on the Environment node and press Tuned for on PPO to load tuned settings, then Train.",
  "category": "Reinforcement Learning",
  "tags": ["ppo", "reinforcement", "rl", "policy", "cartpole", "mujoco"],
  "parameters": [
    {
      "name": "hidden_size",
      "type": "int",
      "default_value": "64",
      "description": "Units in each hidden layer of both networks",
      "min_value": "4",
      "max_value": "4096"
    },
    {
      "name": "activation",
      "type": "nodetype",
      "default_value": "Tanh",
      "description": "Activation between the layers",
      "options": ["Tanh", "ReLU", "LeakyReLU", "GELU", "Swish"]
    }
  ],
  "template": {
    "nodes": [
      {"id": "env", "type": "RLEnvironment", "name": "Environment", "pos": [0, 300],
       "params": {"environment": "cyxwiz.builtin:CartPole-v1", "copies": "8"}},
      {"id": "p1", "type": "Dense", "name": "Policy Dense 1", "pos": [220, 100], "params": {"units": "$hidden_size"}},
      {"id": "pa1", "type": "$activation", "name": "Policy Activation 1", "pos": [400, 100]},
      {"id": "p2", "type": "Dense", "name": "Policy Dense 2", "pos": [580, 100], "params": {"units": "$hidden_size"}},
      {"id": "pa2", "type": "$activation", "name": "Policy Activation 2", "pos": [760, 100]},
      {"id": "phead", "type": "PolicyHead", "name": "Policy Head", "pos": [940, 100]},
      {"id": "v1", "type": "Dense", "name": "Value Dense 1", "pos": [220, 500], "params": {"units": "$hidden_size"}},
      {"id": "va1", "type": "$activation", "name": "Value Activation 1", "pos": [400, 500]},
      {"id": "v2", "type": "Dense", "name": "Value Dense 2", "pos": [580, 500], "params": {"units": "$hidden_size"}},
      {"id": "va2", "type": "$activation", "name": "Value Activation 2", "pos": [760, 500]},
      {"id": "vhead", "type": "ValueHead", "name": "Value Head", "pos": [940, 500]},
      {"id": "ppo", "type": "PPO", "name": "PPO", "pos": [1160, 300]}
    ],
    "links": [
      {"from": "env", "to": "p1"},
      {"from": "p1", "to": "pa1"},
      {"from": "pa1", "to": "p2"},
      {"from": "p2", "to": "pa2"},
      {"from": "pa2", "to": "phead"},
      {"from": "env", "to": "v1"},
      {"from": "v1", "to": "va1"},
      {"from": "va1", "to": "v2"},
      {"from": "v2", "to": "va2"},
      {"from": "va2", "to": "vhead"},
      {"from": "phead", "to": "ppo", "to_pin": 0},
      {"from": "env", "from_pin": 1, "to": "ppo", "to_pin": 1},
      {"from": "vhead", "to": "ppo", "to_pin": 2}
    ]
  }
}
