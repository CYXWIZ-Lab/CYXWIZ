{
  "id": "phase3_demo",
  "name": "Skip Connections and Merges",
  "kind": "graph",
  "description": "A graph with branches: a residual Add, a dense skip (Concatenate of a layer's input and output), self-attention with its residual and LayerNorm, and an Add of three branches. Expects a CSV table: number columns and a label column (classes). Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[20]",
  "category": "Basic",
  "tags": ["residual", "skip", "concatenate", "attention", "branches", "merge"],
  "parameters": [
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "10",
      "description": "Number of classes",
      "min_value": "2",
      "max_value": "10000"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 260], "params": {"source_type": "file", "file_category": "tabular", "file_type": "csv", "has_header": "true", "label_column": "label"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [220, 260], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [440, 260], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "d1", "type": "Dense", "name": "Dense 256", "pos": [660, 260], "params": {"units": "256"}},
      {"id": "bn1", "type": "BatchNorm", "name": "BatchNorm 1", "pos": [860, 120]},
      {"id": "relu1", "type": "ReLU", "name": "ReLU 1", "pos": [1060, 120]},
      {"id": "d2", "type": "Dense", "name": "Dense 256 b", "pos": [1260, 120], "params": {"units": "256"}},
      {"id": "bn2", "type": "BatchNorm", "name": "BatchNorm 2", "pos": [1460, 120]},
      {"id": "add1", "type": "Add", "name": "Residual Add", "pos": [1660, 260]},
      {"id": "relu2", "type": "ReLU", "name": "ReLU 2", "pos": [1860, 260]},
      {"id": "d3", "type": "Dense", "name": "Dense 512", "pos": [2060, 120], "params": {"units": "512"}},
      {"id": "gelu", "type": "GELU", "name": "GELU", "pos": [2260, 120]},
      {"id": "d4", "type": "Dense", "name": "Dense 512 b", "pos": [2460, 120], "params": {"units": "512"}},
      {"id": "concat", "type": "Concatenate", "name": "Dense skip (Concatenate)", "pos": [2660, 260], "params": {"dim": "1"}},
      {"id": "d5", "type": "Dense", "name": "Dense 256 c", "pos": [2860, 260], "params": {"units": "256"}},
      {"id": "mha", "type": "MultiHeadAttention", "name": "Self-attention", "pos": [3060, 120], "params": {"embed_dim": "256", "num_heads": "8", "dropout": "0.0"}},
      {"id": "add2", "type": "Add", "name": "Attention residual", "pos": [3260, 120]},
      {"id": "ln", "type": "LayerNorm", "name": "LayerNorm", "pos": [3460, 120]},
      {"id": "add3", "type": "Add", "name": "3-way Add", "pos": [3660, 260]},
      {"id": "head", "type": "Dense", "name": "Classes", "pos": [3860, 260], "params": {"units": "$num_classes"}},
      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [4080, 320]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [4300, 320], "params": {"learning_rate": "0.001", "beta1": "0.9", "beta2": "0.999", "epsilon": "1e-8"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [4520, 320], "params": {"num_classes": "$num_classes"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split", "from_pin": 0, "to_pin": 0},
      {"from": "data_split", "to": "data_loader", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "d1", "from_pin": 0, "to_pin": 0},
      {"from": "d1", "to": "bn1", "from_pin": 0, "to_pin": 0},
      {"from": "bn1", "to": "relu1", "from_pin": 0, "to_pin": 0},
      {"from": "relu1", "to": "d2", "from_pin": 0, "to_pin": 0},
      {"from": "d2", "to": "bn2", "from_pin": 0, "to_pin": 0},
      {"from": "bn2", "to": "add1", "from_pin": 0, "to_pin": 0},
      {"from": "d1", "to": "add1", "from_pin": 0, "to_pin": 1},
      {"from": "add1", "to": "relu2", "from_pin": 0, "to_pin": 0},
      {"from": "relu2", "to": "d3", "from_pin": 0, "to_pin": 0},
      {"from": "d3", "to": "gelu", "from_pin": 0, "to_pin": 0},
      {"from": "gelu", "to": "d4", "from_pin": 0, "to_pin": 0},
      {"from": "d4", "to": "concat", "from_pin": 0, "to_pin": 0},
      {"from": "relu2", "to": "concat", "from_pin": 0, "to_pin": 1},
      {"from": "concat", "to": "d5", "from_pin": 0, "to_pin": 0},
      {"from": "d5", "to": "mha", "from_pin": 0, "to_pin": 0},
      {"from": "mha", "to": "add2", "from_pin": 0, "to_pin": 0},
      {"from": "d5", "to": "add2", "from_pin": 0, "to_pin": 1},
      {"from": "add2", "to": "ln", "from_pin": 0, "to_pin": 0},
      {"from": "relu2", "to": "add3", "from_pin": 0, "to_pin": 0},
      {"from": "d5", "to": "add3", "from_pin": 0, "to_pin": 1},
      {"from": "ln", "to": "add3", "from_pin": 0, "to_pin": 2},
      {"from": "add3", "to": "head", "from_pin": 0, "to_pin": 0},
      {"from": "head", "to": "loss", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "loss", "from_pin": 1, "to_pin": 1},
      {"from": "loss", "to": "optimizer", "from_pin": 0, "to_pin": 0},
      {"from": "optimizer", "to": "output", "from_pin": 0, "to_pin": 0}
    ]
  }
}
