{
  "id": "cnn_basic",
  "name": "Basic CNN",
  "kind": "graph",
  "description": "Two Conv2D / ReLU / MaxPool stages and a Dense head: a first image classifier. Expects an image folder with one subfolder per class (resized to 32 x 32). Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[32, 32, 3]",
  "category": "CNN",
  "tags": ["cnn", "convolution", "image", "classification", "vision"],
  "parameters": [
    {
      "name": "filters1",
      "type": "int",
      "default_value": "32",
      "description": "Filters in first conv layer",
      "min_value": "8",
      "max_value": "512"
    },
    {
      "name": "filters2",
      "type": "int",
      "default_value": "64",
      "description": "Filters in second conv layer",
      "min_value": "8",
      "max_value": "512"
    },
    {
      "name": "dense_units",
      "type": "int",
      "default_value": "128",
      "description": "Units in dense layer",
      "min_value": "32",
      "max_value": "2048"
    },
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "10",
      "description": "Number of output classes",
      "min_value": "2",
      "max_value": "10000"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 260], "params": {"source_type": "folder", "file_category": "image", "image_layout": "1"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [220, 260], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [440, 260], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "resize", "type": "Resize", "name": "Resize 32", "pos": [660, 260], "params": {"width": "32", "height": "32", "mode": "exact"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize", "pos": [880, 260], "params": {"statistics": "same", "mean": "0.5", "std": "0.5"}},
      {"id": "conv1", "type": "Conv2D", "name": "Conv2D 1", "pos": [1100, 260], "params": {"filters": "$filters1", "kernel_size": "3"}},
      {"id": "relu1", "type": "ReLU", "name": "ReLU 1", "pos": [1300, 260]},
      {"id": "pool1", "type": "MaxPool2D", "name": "MaxPool 1", "pos": [1500, 260]},
      {"id": "conv2", "type": "Conv2D", "name": "Conv2D 2", "pos": [1700, 260], "params": {"filters": "$filters2", "kernel_size": "3"}},
      {"id": "relu2", "type": "ReLU", "name": "ReLU 2", "pos": [1900, 260]},
      {"id": "pool2", "type": "MaxPool2D", "name": "MaxPool 2", "pos": [2100, 260]},
      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [2300, 260]},
      {"id": "dense1", "type": "Dense", "name": "Dense", "pos": [2500, 260], "params": {"units": "$dense_units"}},
      {"id": "relu3", "type": "ReLU", "name": "ReLU 3", "pos": [2700, 260]},
      {"id": "output_layer", "type": "Dense", "name": "Output", "pos": [2900, 260], "params": {"units": "$num_classes"}},
      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [3120, 320]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [3340, 320], "params": {"learning_rate": "0.001", "beta1": "0.9", "beta2": "0.999", "epsilon": "1e-8"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [3560, 320], "params": {"num_classes": "$num_classes"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split", "from_pin": 0, "to_pin": 0},
      {"from": "data_split", "to": "data_loader", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "resize", "from_pin": 0, "to_pin": 0},
      {"from": "resize", "to": "normalize", "from_pin": 0, "to_pin": 0},
      {"from": "normalize", "to": "conv1", "from_pin": 0, "to_pin": 0},
      {"from": "conv1", "to": "relu1"},
      {"from": "relu1", "to": "pool1"},
      {"from": "pool1", "to": "conv2"},
      {"from": "conv2", "to": "relu2"},
      {"from": "relu2", "to": "pool2"},
      {"from": "pool2", "to": "flatten"},
      {"from": "flatten", "to": "dense1"},
      {"from": "dense1", "to": "relu3"},
      {"from": "relu3", "to": "output_layer"},
      {"from": "output_layer", "to": "loss", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "loss", "from_pin": 1, "to_pin": 1},
      {"from": "loss", "to": "optimizer", "from_pin": 0, "to_pin": 0},
      {"from": "optimizer", "to": "output", "from_pin": 0, "to_pin": 0}
    ]
  }
}
