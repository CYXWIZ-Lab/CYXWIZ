{
  "id": "mobilenet_v2",
  "name": "MobileNetV2",
  "kind": "graph",
  "description": "MobileNetV2 (Sandler et al. 2018) exactly as torchvision builds it: inverted residual blocks (1 x 1 expansion, 3 x 3 depthwise, 1 x 1 projection, ReLU6), Global Avg Pool, Dropout, a Dense head. Expects an image folder with one subfolder per class (resized to 256, centre 224 x 224, ImageNet statistics). Every layer is named as torchvision names it (105 layers with weights), so torchvision's ImageNet weights fill it: download mobilenet_v2-b0353104.pth (https://download.pytorch.org/models/mobilenet_v2-b0353104.pth), double-click DataLoader, Checkpoints tab, Start from: A weights file. With num_classes other than 1000 the last layer (classifier.1) starts fresh; turn on freeze_backbone to train only it. Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[224, 224, 3]",
  "category": "CNN",
  "tags": ["mobilenet", "mobilenetv2", "efficient", "mobile", "depthwise", "pretrained", "imagenet", "torchvision"],
  "parameters": [
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "1000",
      "description": "Number of output classes (1000 keeps the ImageNet head)",
      "min_value": "2",
      "max_value": "10000"
    },
    {
      "name": "freeze_backbone",
      "type": "bool",
      "default_value": "false",
      "description": "Freeze every layer with weights except the head (classifier.1)"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0.0, 260.0], "params": {"source_type": "folder", "file_category": "image", "image_layout": "0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [220.0, 260.0], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [440.0, 260.0], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "resize", "type": "Resize", "name": "Resize 256", "pos": [660.0, 260.0], "params": {"width": "256", "height": "256", "mode": "exact"}},
      {"id": "center_crop", "type": "CenterCrop", "name": "Center Crop 224", "pos": [880.0, 260.0], "params": {"width": "224", "height": "224"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize (ImageNet)", "pos": [1100.0, 260.0], "params": {"statistics": "imagenet"}},
      {"id": "features_0_0", "type": "Conv2D", "name": "features.0.0", "pos": [160.0, 460.0], "params": {"filters": "32", "kernel_size": "3", "stride": "2", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "features_0_1", "type": "BatchNorm", "name": "features.0.1", "pos": [380.0, 460.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "features_0_2", "type": "ReLU6", "name": "features.0.2", "pos": [600.0, 460.0]},
      {"id": "features_1_conv_0_0", "type": "DepthwiseConv2D", "name": "features.1.conv.0.0", "pos": [160.0, 660.0], "params": {"kernel_size": "3", "stride": "1", "padding": "same", "use_bias": "false", "depth_multiplier": "1", "frozen": "$freeze_backbone"}},
      {"id": "features_1_conv_0_1", "type": "BatchNorm", "name": "features.1.conv.0.1", "pos": [380.0, 660.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "features_1_conv_0_2", "type": "ReLU6", "name": "features.1.conv.0.2", "pos": [600.0, 660.0]},
      {"id": "features_1_conv_1", "type": "Conv2D", "name": "features.1.conv.1", "pos": [820.0, 660.0], "params": {"filters": "16", "kernel_size": "1", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "features_1_conv_2", "type": "BatchNorm", "name": "features.1.conv.2", "pos": [1040.0, 660.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
      {"id": "features_2_conv_0_0", "type": "Conv2D", "name": "features.2.conv.0.0", "pos": [160.0, 860.0], "params": {"filters": "96", "kernel_size": "1", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "features_2_conv_0_1", "type": "BatchNorm", "name": "features.2.conv.0.1", "pos": [380.0, 860.0], "params": {"eps": "1e-05", "momentum": "0.1", "frozen": "$freeze_backbone"}},
