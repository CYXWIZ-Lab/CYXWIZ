{
  "id": "bilstm",
  "name": "Bidirectional LSTM",
  "kind": "graph",
  "description": "A bidirectional LSTM over word embeddings, then a Dense head. Expects a CSV with a text column and a label column. Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[$max_length]",
  "category": "RNN",
  "tags": ["bilstm", "bidirectional", "lstm", "sequence", "nlp"],
  "parameters": [
    {
      "name": "hidden_size",
      "type": "int",
      "default_value": "128",
      "description": "Number of LSTM hidden units (per direction)",
      "min_value": "32",
      "max_value": "1024"
    },
    {
      "name": "embedding_dim",
      "type": "int",
      "default_value": "100",
      "description": "Dimension of embedding vectors",
      "min_value": "16",
      "max_value": "512"
    },
    {
      "name": "vocab_size",
      "type": "int",
      "default_value": "10000",
      "description": "Size of vocabulary",
      "min_value": "100",
      "max_value": "100000"
    },
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "2",
      "description": "Number of output classes",
      "min_value": "2",
      "max_value": "1000"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.3",
      "description": "Dropout rate",
      "min_value": "0.0",
      "max_value": "0.7"
    },
    {
      "name": "max_length",
      "type": "int",
      "default_value": "64",
      "description": "Tokens kept per text (longer texts are cut, shorter ones padded)",
      "min_value": "4",
      "max_value": "4096"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 260], "params": {"source_type": "file", "file_category": "text", "file_type": "csv", "text_column": "text", "text_label_column": "label", "text_tokenizer_type": "1", "text_max_length": "$max_length", "text_lowercase": "true", "text_max_vocab_size": "$vocab_size"}},
      {"id": "tokenizer", "type": "TextTokenizer", "name": "Text Tokenizer", "pos": [220, 260], "params": {"tokenizer_type": "1", "max_length": "$max_length", "lowercase": "true", "max_vocab_size": "$vocab_size", "text_col": "text", "label_col": "label", "min_word_freq": "2", "padding": "true", "truncation": "true", "pad_value": "0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [440, 260], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [660, 260], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "embed", "type": "Embedding", "name": "Embedding", "pos": [880, 260], "params": {"num_embeddings": "$vocab_size", "embedding_dim": "$embedding_dim"}},
      {"id": "dropout1", "type": "Dropout", "name": "Dropout 1", "pos": [1080, 260], "params": {"rate": "$dropout_rate"}},
      {"id": "bilstm", "type": "LSTM", "name": "BiLSTM", "pos": [1280, 260], "params": {"hidden_size": "$hidden_size", "bidirectional": "true"}},
      {"id": "dropout2", "type": "Dropout", "name": "Dropout 2", "pos": [1480, 260], "params": {"rate": "$dropout_rate"}},
      {"id": "dense1", "type": "Dense", "name": "Dense", "pos": [1680, 260], "params": {"units": "64"}},
      {"id": "act1", "type": "ReLU", "name": "ReLU", "pos": [1880, 260]},
      {"id": "output_layer", "type": "Dense", "name": "Output", "pos": [2080, 260], "params": {"units": "$num_classes"}},
      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [2300, 320]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [2520, 320], "params": {"learning_rate": "0.001", "beta1": "0.9", "beta2": "0.999", "epsilon": "1e-8"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [2740, 320], "params": {"num_classes": "$num_classes"}}
    ],
    "links": [
      {"from": "data_input", "to": "tokenizer", "from_pin": 0, "to_pin": 0},
      {"from": "tokenizer", "to": "data_split", "from_pin": 0, "to_pin": 0},
      {"from": "data_split", "to": "data_loader", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "embed", "from_pin": 0, "to_pin": 0},
      {"from": "embed", "to": "dropout1"},
      {"from": "dropout1", "to": "bilstm"},
      {"from": "bilstm", "to": "dropout2"},
      {"from": "dropout2", "to": "dense1"},
      {"from": "dense1", "to": "act1"},
      {"from": "act1", "to": "output_layer"},
      {"from": "output_layer", "to": "loss", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "loss", "from_pin": 1, "to_pin": 1},
      {"from": "loss", "to": "optimizer", "from_pin": 0, "to_pin": 0},
      {"from": "optimizer", "to": "output", "from_pin": 0, "to_pin": 0}
    ]
  }
}
