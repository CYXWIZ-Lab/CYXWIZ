{
  "id": "transformer_decoder",
  "name": "Causal Decoder Starter (CPU-backed)",
  "description": "Small decoder-only causal transformer starter using the tested CPU-backed path. Useful for controlled next-token/logit-head experiments; full GPT-style text generation controls are still roadmap work.",
  "category": "Transformer",
  "tags": ["transformer", "attention", "decoder", "causal", "gpt", "language-model", "cpu-backed"],
  "parameters": [
    {
      "name": "d_model",
      "type": "int",
      "default_value": "64",
      "description": "Model dimension (embedding size)",
      "min_value": "64",
      "max_value": "2048"
    },
    {
      "name": "num_heads",
      "type": "int",
      "default_value": "4",
      "description": "Number of attention heads",
      "min_value": "1",
      "max_value": "32"
    },
    {
      "name": "ff_dim",
      "type": "int",
      "default_value": "256",
      "description": "Feed-forward hidden dimension",
      "min_value": "64",
      "max_value": "4096"
    },
    {
      "name": "vocab_size",
      "type": "int",
      "default_value": "5000",
      "description": "Vocabulary size",
      "min_value": "100",
      "max_value": "100000"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.1",
      "description": "Dropout rate",
      "min_value": "0.0",
      "max_value": "0.5"
    }
  ],
  "template": {
    "nodes": [
      {"id": "input", "type": "DatasetInput", "name": "Token Input", "pos": [0, 200]},
      {"id": "embed", "type": "Embedding", "name": "Token Embedding", "pos": [220, 200], "params": {"num_embeddings": "$vocab_size", "embedding_dim": "$d_model"}},
      {"id": "pos_enc", "type": "PositionalEncoding", "name": "Positional Encoding", "pos": [440, 200], "params": {"d_model": "$d_model"}},
      {"id": "dropout1", "type": "Dropout", "name": "Dropout", "pos": [660, 200], "params": {"rate": "$dropout_rate"}},
      {"id": "dec1", "type": "TransformerDecoder", "name": "Causal Decoder 1", "pos": [880, 200], "params": {"d_model": "$d_model", "num_heads": "$num_heads", "dim_feedforward": "$ff_dim", "dropout": "$dropout_rate"}},
      {"id": "dec2", "type": "TransformerDecoder", "name": "Causal Decoder 2", "pos": [1100, 200], "params": {"d_model": "$d_model", "num_heads": "$num_heads", "dim_feedforward": "$ff_dim", "dropout": "$dropout_rate"}},
      {"id": "ln", "type": "LayerNorm", "name": "Layer Norm", "pos": [1320, 200]},
      {"id": "flatten", "type": "Flatten", "name": "Flatten Sequence", "pos": [1540, 200]},
      {"id": "output_layer", "type": "Dense", "name": "Logit Head", "pos": [1760, 200], "params": {"units": "$vocab_size"}},
      {"id": "softmax", "type": "Softmax", "name": "Softmax", "pos": [1980, 200]},
      {"id": "output", "type": "Output", "name": "Output", "pos": [2200, 200]}
    ],
    "links": [
      {"from": "input", "to": "embed"},
      {"from": "embed", "to": "pos_enc"},
      {"from": "pos_enc", "to": "dropout1"},
      {"from": "dropout1", "to": "dec1"},
      {"from": "dec1", "to": "dec2"},
      {"from": "dec2", "to": "ln"},
      {"from": "ln", "to": "flatten"},
      {"from": "flatten", "to": "output_layer"},
      {"from": "output_layer", "to": "softmax"},
      {"from": "softmax", "to": "output"}
    ]
  }
}
