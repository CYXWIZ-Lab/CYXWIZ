{
  "id": "cnn_classifier",
  "name": "CNN Image Classifier",
  "kind": "graph",
  "description": "Two stages of Conv2D / BatchNorm / ReLU pairs with MaxPool, then Dropout and a Dense head. Expects an image folder with one subfolder per class (resized to 32 x 32). Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[32, 32, 3]",
  "category": "CNN",
  "tags": ["cnn", "conv2d", "batchnorm", "image", "classification", "computer-vision"],
  "parameters": [
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "10",
      "description": "Number of output classes",
      "min_value": "2",
      "max_value": "10000"
    },
    {
      "name": "base_filters",
      "type": "int",
      "default_value": "32",
      "description": "Number of filters in first conv layer (doubles in deeper layers)",
      "min_value": "8",
      "max_value": "256"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.25",
      "description": "Dropout rate before fully connected layers",
      "min_value": "0.0",
      "max_value": "0.5"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 260], "params": {"source_type": "folder", "file_category": "image", "image_layout": "1"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [220, 260], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [440, 260], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "resize", "type": "Resize", "name": "Resize 32", "pos": [660, 260], "params": {"width": "32", "height": "32", "mode": "exact"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize", "pos": [880, 260], "params": {"statistics": "same", "mean": "0.5", "std": "0.5"}},
      {"id": "conv1", "type": "Conv2D", "name": "Conv 3x3", "pos": [1100, 260], "params": {"filters": "$base_filters", "kernel_size": "3", "padding": "same"}},
      {"id": "bn1", "type": "BatchNorm", "name": "BatchNorm 1", "pos": [1300, 260]},
      {"id": "act1", "type": "ReLU", "name": "ReLU 1", "pos": [1500, 260]},
      {"id": "conv2", "type": "Conv2D", "name": "Conv 3x3", "pos": [1700, 260], "params": {"filters": "$base_filters", "kernel_size": "3", "padding": "same"}},
      {"id": "bn2", "type": "BatchNorm", "name": "BatchNorm 2", "pos": [1900, 260]},
      {"id": "act2", "type": "ReLU", "name": "ReLU 2", "pos": [2100, 260]},
      {"id": "pool1", "type": "MaxPool2D", "name": "MaxPool 2x2", "pos": [2300, 260], "params": {"pool_size": "2"}},
      {"id": "conv3", "type": "Conv2D", "name": "Conv 3x3", "pos": [1100, 460], "params": {"filters": "64", "kernel_size": "3", "padding": "same"}},
      {"id": "bn3", "type": "BatchNorm", "name": "BatchNorm 3", "pos": [1300, 460]},
      {"id": "act3", "type": "ReLU", "name": "ReLU 3", "pos": [1500, 460]},
      {"id": "conv4", "type": "Conv2D", "name": "Conv 3x3", "pos": [1700, 460], "params": {"filters": "64", "kernel_size": "3", "padding": "same"}},
      {"id": "bn4", "type": "BatchNorm", "name": "BatchNorm 4", "pos": [1900, 460]},
      {"id": "act4", "type": "ReLU", "name": "ReLU 4", "pos": [2100, 460]},
      {"id": "pool2", "type": "MaxPool2D", "name": "MaxPool 2x2", "pos": [2300, 460], "params": {"pool_size": "2"}},
      {"id": "flatten", "type": "Flatten", "name": "Flatten", "pos": [1100, 660]},
      {"id": "dropout", "type": "Dropout", "name": "Dropout", "pos": [1300, 660], "params": {"rate": "$dropout_rate"}},
      {"id": "dense1", "type": "Dense", "name": "Dense 256", "pos": [1500, 660], "params": {"units": "256"}},
      {"id": "act5", "type": "ReLU", "name": "ReLU 5", "pos": [1700, 660]},
      {"id": "output_layer", "type": "Dense", "name": "Output", "pos": [1900, 660], "params": {"units": "$num_classes"}},
      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [2520, 320]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [2740, 320], "params": {"learning_rate": "0.001", "beta1": "0.9", "beta2": "0.999", "epsilon": "1e-8"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [2960, 320], "params": {"num_classes": "$num_classes"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split", "from_pin": 0, "to_pin": 0},
      {"from": "data_split", "to": "data_loader", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "resize", "from_pin": 0, "to_pin": 0},
      {"from": "resize", "to": "normalize", "from_pin": 0, "to_pin": 0},
      {"from": "normalize", "to": "conv1", "from_pin": 0, "to_pin": 0},
      {"from": "conv1", "to": "bn1"},
      {"from": "bn1", "to": "act1"},
      {"from": "act1", "to": "conv2"},
      {"from": "conv2", "to": "bn2"},
      {"from": "bn2", "to": "act2"},
      {"from": "act2", "to": "pool1"},
      {"from": "pool1", "to": "conv3"},
      {"from": "conv3", "to": "bn3"},
      {"from": "bn3", "to": "act3"},
      {"from": "act3", "to": "conv4"},
      {"from": "conv4", "to": "bn4"},
      {"from": "bn4", "to": "act4"},
      {"from": "act4", "to": "pool2"},
      {"from": "pool2", "to": "flatten"},
      {"from": "flatten", "to": "dropout"},
      {"from": "dropout", "to": "dense1"},
      {"from": "dense1", "to": "act5"},
      {"from": "act5", "to": "output_layer"},
      {"from": "output_layer", "to": "loss", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "loss", "from_pin": 1, "to_pin": 1},
      {"from": "loss", "to": "optimizer", "from_pin": 0, "to_pin": 0},
      {"from": "optimizer", "to": "output", "from_pin": 0, "to_pin": 0}
    ]
  }
}
