{
  "id": "mobilenet",
  "name": "MobileNet v1",
  "kind": "graph",
  "description": "MobileNet v1 (Howard et al. 2017), shortened: depthwise separable Conv2D stages, Global Avg Pool, Dense head. Expects an image folder with one subfolder per class (resized to 256, centre 224 x 224, ImageNet statistics). Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[224, 224, 3]",
  "category": "CNN",
  "tags": ["mobilenet", "efficient", "mobile", "edge", "lightweight", "depthwise"],
  "parameters": [
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "1000",
      "description": "Number of output classes",
      "min_value": "2",
      "max_value": "10000"
    },
    {
      "name": "width_multiplier",
      "type": "float",
      "default_value": "1.0",
      "description": "Width multiplier (0.25, 0.5, 0.75, 1.0)",
      "min_value": "0.25",
      "max_value": "1.0"
    },
    {
      "name": "dropout_rate",
      "type": "float",
      "default_value": "0.001",
      "description": "Dropout rate before final layer",
      "min_value": "0.0",
      "max_value": "0.5"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0, 260], "params": {"source_type": "folder", "file_category": "image", "image_layout": "1"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [220, 260], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [440, 260], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "resize", "type": "Resize", "name": "Resize 256", "pos": [660, 260], "params": {"width": "256", "height": "256", "mode": "exact"}},
      {"id": "center_crop", "type": "CenterCrop", "name": "Center Crop 224", "pos": [880, 260], "params": {"width": "224", "height": "224"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize (ImageNet)", "pos": [1100, 260], "params": {"statistics": "imagenet"}},
      {"id": "conv1", "type": "Conv2D", "name": "Conv 3x3/2", "pos": [1470, 260], "params": {"filters": "32", "kernel_size": "3", "stride": "2", "padding": "same"}},
      {"id": "bn1", "type": "BatchNorm", "name": "BN", "pos": [1620, 260]},
      {"id": "act1", "type": "ReLU", "name": "ReLU", "pos": [1770, 260]},
      {"id": "dw1", "type": "DepthwiseConv2D", "name": "DW Conv 3x3", "pos": [1920, 260], "params": {"kernel_size": "3", "padding": "same"}},
      {"id": "bn2", "type": "BatchNorm", "name": "BN", "pos": [2070, 260]},
      {"id": "act2", "type": "ReLU", "name": "ReLU", "pos": [2220, 260]},
      {"id": "pw1", "type": "Conv2D", "name": "PW Conv 1x1", "pos": [2370, 260], "params": {"filters": "64", "kernel_size": "1"}},
      {"id": "bn3", "type": "BatchNorm", "name": "BN", "pos": [2520, 260]},
      {"id": "act3", "type": "ReLU", "name": "ReLU", "pos": [2670, 260]},
      {"id": "dw2", "type": "DepthwiseConv2D", "name": "DW Conv 3x3/2", "pos": [2820, 260], "params": {"kernel_size": "3", "stride": "2", "padding": "same"}},
      {"id": "bn4", "type": "BatchNorm", "name": "BN", "pos": [2970, 260]},
      {"id": "act4", "type": "ReLU", "name": "ReLU", "pos": [3120, 260]},
      {"id": "pw2", "type": "Conv2D", "name": "PW Conv 1x1", "pos": [3270, 260], "params": {"filters": "128", "kernel_size": "1"}},
      {"id": "bn5", "type": "BatchNorm", "name": "BN", "pos": [3420, 260]},
      {"id": "act5", "type": "ReLU", "name": "ReLU", "pos": [3570, 260]},
      {"id": "dw3", "type": "DepthwiseConv2D", "name": "DW Conv 3x3", "pos": [1320, 460], "params": {"kernel_size": "3", "padding": "same"}},
      {"id": "bn6", "type": "BatchNorm", "name": "BN", "pos": [1470, 460]},
      {"id": "act6", "type": "ReLU", "name": "ReLU", "pos": [1620, 460]},
      {"id": "pw3", "type": "Conv2D", "name": "PW Conv 1x1", "pos": [1770, 460], "params": {"filters": "128", "kernel_size": "1"}},
      {"id": "bn7", "type": "BatchNorm", "name": "BN", "pos": [1920, 460]},
      {"id": "act7", "type": "ReLU", "name": "ReLU", "pos": [2070, 460]},
      {"id": "dw4", "type": "DepthwiseConv2D", "name": "DW Conv 3x3/2", "pos": [2220, 460], "params": {"kernel_size": "3", "stride": "2", "padding": "same"}},
      {"id": "bn8", "type": "BatchNorm", "name": "BN", "pos": [2370, 460]},
      {"id": "act8", "type": "ReLU", "name": "ReLU", "pos": [2520, 460]},
      {"id": "pw4", "type": "Conv2D", "name": "PW Conv 1x1", "pos": [2670, 460], "params": {"filters": "256", "kernel_size": "1"}},
      {"id": "bn9", "type": "BatchNorm", "name": "BN", "pos": [2820, 460]},
      {"id": "act9", "type": "ReLU", "name": "ReLU", "pos": [2970, 460]},
      {"id": "dw5", "type": "DepthwiseConv2D", "name": "DW Conv 3x3/2", "pos": [3120, 460], "params": {"kernel_size": "3", "stride": "2", "padding": "same"}},
      {"id": "bn10", "type": "BatchNorm", "name": "BN", "pos": [3270, 460]},
      {"id": "act10", "type": "ReLU", "name": "ReLU", "pos": [3420, 460]},
      {"id": "pw5", "type": "Conv2D", "name": "PW Conv 1x1", "pos": [3570, 460], "params": {"filters": "512", "kernel_size": "1"}},
      {"id": "bn11", "type": "BatchNorm", "name": "BN", "pos": [3720, 460]},
      {"id": "act11", "type": "ReLU", "name": "ReLU", "pos": [3870, 460]},
      {"id": "gap", "type": "GlobalAvgPool", "name": "Global Avg Pool", "pos": [1320, 660]},
      {"id": "dropout", "type": "Dropout", "name": "Dropout", "pos": [1470, 660], "params": {"rate": "$dropout_rate"}},
      {"id": "fc", "type": "Dense", "name": "Output", "pos": [1620, 660], "params": {"units": "$num_classes"}},
      {"id": "loss", "type": "CrossEntropyLoss", "name": "CrossEntropy", "pos": [4090, 320]},
      {"id": "optimizer", "type": "Adam", "name": "Adam", "pos": [4310, 320], "params": {"learning_rate": "0.001", "beta1": "0.9", "beta2": "0.999", "epsilon": "1e-8"}},
      {"id": "output", "type": "Output", "name": "Output", "pos": [4530, 320], "params": {"num_classes": "$num_classes"}}
    ],
    "links": [
      {"from": "data_input", "to": "data_split", "from_pin": 0, "to_pin": 0},
      {"from": "data_split", "to": "data_loader", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "resize", "from_pin": 0, "to_pin": 0},
      {"from": "resize", "to": "center_crop", "from_pin": 0, "to_pin": 0},
      {"from": "center_crop", "to": "normalize", "from_pin": 0, "to_pin": 0},
      {"from": "normalize", "to": "conv1", "from_pin": 0, "to_pin": 0},
      {"from": "conv1", "to": "bn1"},
      {"from": "bn1", "to": "act1"},
      {"from": "act1", "to": "dw1"},
      {"from": "dw1", "to": "bn2"},
      {"from": "bn2", "to": "act2"},
      {"from": "act2", "to": "pw1"},
      {"from": "pw1", "to": "bn3"},
      {"from": "bn3", "to": "act3"},
      {"from": "act3", "to": "dw2"},
      {"from": "dw2", "to": "bn4"},
      {"from": "bn4", "to": "act4"},
      {"from": "act4", "to": "pw2"},
      {"from": "pw2", "to": "bn5"},
      {"from": "bn5", "to": "act5"},
      {"from": "act5", "to": "dw3"},
      {"from": "dw3", "to": "bn6"},
      {"from": "bn6", "to": "act6"},
      {"from": "act6", "to": "pw3"},
      {"from": "pw3", "to": "bn7"},
      {"from": "bn7", "to": "act7"},
      {"from": "act7", "to": "dw4"},
      {"from": "dw4", "to": "bn8"},
      {"from": "bn8", "to": "act8"},
      {"from": "act8", "to": "pw4"},
      {"from": "pw4", "to": "bn9"},
      {"from": "bn9", "to": "act9"},
      {"from": "act9", "to": "dw5"},
      {"from": "dw5", "to": "bn10"},
      {"from": "bn10", "to": "act10"},
      {"from": "act10", "to": "pw5"},
      {"from": "pw5", "to": "bn11"},
      {"from": "bn11", "to": "act11"},
      {"from": "act11", "to": "gap"},
      {"from": "gap", "to": "dropout"},
      {"from": "dropout", "to": "fc"},
      {"from": "fc", "to": "loss", "from_pin": 0, "to_pin": 0},
      {"from": "data_loader", "to": "loss", "from_pin": 1, "to_pin": 1},
      {"from": "loss", "to": "optimizer", "from_pin": 0, "to_pin": 0},
      {"from": "optimizer", "to": "output", "from_pin": 0, "to_pin": 0}
    ]
  }
}
