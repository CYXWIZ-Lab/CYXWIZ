{
  "id": "mobilenet_v3_small",
  "name": "MobileNetV3 Small",
  "kind": "graph",
  "description": "MobileNetV3 small (Howard et al. 2019) exactly as torchvision builds it: inverted residual blocks with Squeeze-Excitation and Hardswish, Global Avg Pool, a Dense / Hardswish / Dropout / Dense classifier. Expects an image folder with one subfolder per class (resized to 256, centre 224 x 224, ImageNet statistics). Every layer is named as torchvision names it (79 layers with weights), so torchvision's ImageNet weights fill it: download mobilenet_v3_small-047dcff4.pth (https://download.pytorch.org/models/mobilenet_v3_small-047dcff4.pth), double-click DataLoader, Checkpoints tab, Start from: A weights file. With num_classes other than 1000 the last layer (classifier.3) starts fresh; turn on freeze_backbone to train only it. Double-click Data Input, point it at your data and click Apply, then Train.",
  "sample_shape": "[224, 224, 3]",
  "category": "CNN",
  "tags": ["mobilenet", "mobilenetv3", "efficient", "mobile", "depthwise", "squeeze-excitation", "pretrained", "imagenet", "torchvision"],
  "parameters": [
    {
      "name": "num_classes",
      "type": "int",
      "default_value": "1000",
      "description": "Number of output classes (1000 keeps the ImageNet head)",
      "min_value": "2",
      "max_value": "10000"
    },
    {
      "name": "freeze_backbone",
      "type": "bool",
      "default_value": "false",
      "description": "Freeze every layer with weights except the head (classifier.3)"
    }
  ],
  "template": {
    "nodes": [
      {"id": "data_input", "type": "DataInput", "name": "Data Input", "pos": [0.0, 260.0], "params": {"source_type": "folder", "file_category": "image", "image_layout": "0"}},
      {"id": "data_split", "type": "DataSplit", "name": "Data Split", "pos": [220.0, 260.0], "params": {"train_ratio": "0.8", "val_ratio": "0.1", "test_ratio": "0.1", "seed": "42", "stratified": "true"}},
      {"id": "data_loader", "type": "DataLoader", "name": "DataLoader", "pos": [440.0, 260.0], "params": {"batch_size": "64", "epochs": "10", "shuffle": "true", "seed": "42", "validation_freq": "1"}},
      {"id": "resize", "type": "Resize", "name": "Resize 256", "pos": [660.0, 260.0], "params": {"width": "256", "height": "256", "mode": "exact"}},
      {"id": "center_crop", "type": "CenterCrop", "name": "Center Crop 224", "pos": [880.0, 260.0], "params": {"width": "224", "height": "224"}},
      {"id": "normalize", "type": "Normalize", "name": "Normalize (ImageNet)", "pos": [1100.0, 260.0], "params": {"statistics": "imagenet"}},
      {"id": "features_0_0", "type": "Conv2D", "name": "features.0.0", "pos": [160.0, 460.0], "params": {"filters": "16", "kernel_size": "3", "stride": "2", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "features_0_1", "type": "BatchNorm", "name": "features.0.1", "pos": [380.0, 460.0], "params": {"eps": "0.001", "momentum": "0.01", "frozen": "$freeze_backbone"}},
      {"id": "features_0_2", "type": "Hardswish", "name": "features.0.2", "pos": [600.0, 460.0]},
      {"id": "features_1_block_0_0", "type": "DepthwiseConv2D", "name": "features.1.block.0.0", "pos": [160.0, 660.0], "params": {"kernel_size": "3", "stride": "2", "padding": "same", "use_bias": "false", "depth_multiplier": "1", "frozen": "$freeze_backbone"}},
      {"id": "features_1_block_0_1", "type": "BatchNorm", "name": "features.1.block.0.1", "pos": [380.0, 660.0], "params": {"eps": "0.001", "momentum": "0.01", "frozen": "$freeze_backbone"}},
      {"id": "features_1_block_0_2", "type": "ReLU", "name": "features.1.block.0.2", "pos": [600.0, 660.0]},
      {"id": "features_1_block_1", "type": "SqueezeExcitation", "name": "features.1.block.1", "pos": [820.0, 660.0], "params": {"width_mode": "exact", "squeeze_channels": "8", "inner_activation": "relu", "gate": "hardsigmoid", "use_bias": "true", "frozen": "$freeze_backbone"}},
      {"id": "features_1_block_2_0", "type": "Conv2D", "name": "features.1.block.2.0", "pos": [1040.0, 660.0], "params": {"filters": "16", "kernel_size": "1", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
      {"id": "features_1_block_2_1", "type": "BatchNorm", "name": "features.1.block.2.1", "pos": [1260.0, 660.0], "params": {"eps": "0.001", "momentum": "0.01", "frozen": "$freeze_backbone"}},
