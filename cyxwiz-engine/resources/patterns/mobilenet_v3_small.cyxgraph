      {"id": "features_3_block_2_0", "type": "Conv2D", "name": "features.3.block.2.0", "pos": [1480.0, 1060.0], "params": {"filters": "24", "kernel_size": "1", "stride": "1", "padding": "same", "use_bias": "false", "frozen": "$freeze_backbone"}},
