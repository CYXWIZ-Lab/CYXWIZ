{
  "id": "sac_mlp",
  "name": "SAC (MLP 256-256)",
  "kind": "graph",
  "description": "Soft Actor-Critic as in Stable-Baselines3's SAC MlpPolicy: an Environment, an actor of two Dense layers with ReLU ending in a Policy Head (a tanh-squashed Gaussian), Q layers of the same shape ending in a Q Head (SAC builds twin Q networks and their targets from them; the action joins the first Q layer), and SAC with its replay buffer. SAC learns continuous actions: pick a MuJoCo task on the Environment node (its plugin loaded) and press Tuned for on SAC to load tuned settings, then Train.",
  "category": "Reinforcement Learning",
  "tags": ["sac", "soft actor-critic", "off-policy", "replay", "reinforcement", "rl", "policy", "mujoco"],
  "parameters": [
    {
      "name": "hidden_size",
      "type": "int",
      "default_value": "256",
      "description": "Units in each hidden layer of the actor and the Q networks",
      "min_value": "4",
      "max_value": "4096"
    },
    {
      "name": "activation",
      "type": "nodetype",
      "default_value": "ReLU",
      "description": "Activation between the layers",
      "options": ["ReLU", "Tanh", "LeakyReLU", "GELU", "Swish"]
    }
  ],
  "template": {
    "nodes": [
      {"id": "env", "type": "RLEnvironment", "name": "Environment", "pos": [0, 300],
       "params": {"environment": "com.cyxwiz.simulation.mujoco:HalfCheetah-v5", "copies": "1"}},
      {"id": "p1", "type": "Dense", "name": "Actor Dense 1", "pos": [220, 100], "params": {"units": "$hidden_size"}},
      {"id": "pa1", "type": "$activation", "name": "Actor Activation 1", "pos": [400, 100]},
      {"id": "p2", "type": "Dense", "name": "Actor Dense 2", "pos": [580, 100], "params": {"units": "$hidden_size"}},
      {"id": "pa2", "type": "$activation", "name": "Actor Activation 2", "pos": [760, 100]},
      {"id": "phead", "type": "PolicyHead", "name": "Policy Head", "pos": [940, 100]},
      {"id": "q1", "type": "Dense", "name": "Q Dense 1", "pos": [220, 500], "params": {"units": "$hidden_size"}},
      {"id": "qa1", "type": "$activation", "name": "Q Activation 1", "pos": [400, 500]},
      {"id": "q2", "type": "Dense", "name": "Q Dense 2", "pos": [580, 500], "params": {"units": "$hidden_size"}},
      {"id": "qa2", "type": "$activation", "name": "Q Activation 2", "pos": [760, 500]},
      {"id": "qhead", "type": "QHead", "name": "Q Head", "pos": [940, 500]},
      {"id": "sac", "type": "SAC", "name": "SAC", "pos": [1160, 300]}
    ],
    "links": [
      {"from": "env", "to": "p1"},
      {"from": "p1", "to": "pa1"},
      {"from": "pa1", "to": "p2"},
      {"from": "p2", "to": "pa2"},
      {"from": "pa2", "to": "phead"},
      {"from": "env", "to": "q1"},
      {"from": "q1", "to": "qa1"},
      {"from": "qa1", "to": "q2"},
      {"from": "q2", "to": "qa2"},
      {"from": "qa2", "to": "qhead"},
      {"from": "phead", "to": "sac", "to_pin": 0},
      {"from": "env", "from_pin": 1, "to": "sac", "to_pin": 1},
      {"from": "qhead", "to": "sac", "to_pin": 2}
    ]
  }
}
