{
  "id": "td3_mlp",
  "name": "TD3 (MLP 400-300)",
  "description": "Twin Delayed DDPG as in Stable-Baselines3's TD3 MlpPolicy: an Environment, an actor of two Dense layers (400 and 300) with ReLU ending in a Policy Head (a deterministic tanh action), Q layers of the same shape ending in a Q Head (TD3 builds twin Q networks and their targets from them; the action joins the first Q layer), and TD3 with its replay buffer and Gaussian exploration noise. TD3 learns continuous actions: pick a MuJoCo task on the Environment node (its plugin loaded) and press Tuned for on TD3 to load tuned settings, then Train.",
  "category": "Reinforcement Learning",
  "tags": ["td3", "twin delayed ddpg", "ddpg", "off-policy", "replay", "reinforcement", "rl", "policy", "mujoco"],
  "parameters": [
    {
      "name": "first_size",
      "type": "int",
      "default_value": "400",
      "description": "Units in the first hidden layer of the actor and the Q networks",
      "min_value": "4",
      "max_value": "4096"
    },
    {
      "name": "second_size",
      "type": "int",
      "default_value": "300",
      "description": "Units in the second hidden layer of the actor and the Q networks",
      "min_value": "4",
      "max_value": "4096"
    },
    {
      "name": "activation",
      "type": "nodetype",
      "default_value": "ReLU",
      "description": "Activation between the layers",
      "options": ["ReLU", "Tanh", "LeakyReLU", "GELU", "Swish"]
    }
  ],
  "template": {
    "nodes": [
      {"id": "env", "type": "RLEnvironment", "name": "Environment", "pos": [0, 300],
       "params": {"environment": "com.cyxwiz.simulation.mujoco:HalfCheetah-v5", "copies": "1"}},
      {"id": "p1", "type": "Dense", "name": "Actor Dense 1", "pos": [220, 100], "params": {"units": "$first_size"}},
      {"id": "pa1", "type": "$activation", "name": "Actor Activation 1", "pos": [400, 100]},
      {"id": "p2", "type": "Dense", "name": "Actor Dense 2", "pos": [580, 100], "params": {"units": "$second_size"}},
      {"id": "pa2", "type": "$activation", "name": "Actor Activation 2", "pos": [760, 100]},
      {"id": "phead", "type": "PolicyHead", "name": "Policy Head", "pos": [940, 100]},
      {"id": "q1", "type": "Dense", "name": "Q Dense 1", "pos": [220, 500], "params": {"units": "$first_size"}},
      {"id": "qa1", "type": "$activation", "name": "Q Activation 1", "pos": [400, 500]},
      {"id": "q2", "type": "Dense", "name": "Q Dense 2", "pos": [580, 500], "params": {"units": "$second_size"}},
      {"id": "qa2", "type": "$activation", "name": "Q Activation 2", "pos": [760, 500]},
      {"id": "qhead", "type": "QHead", "name": "Q Head", "pos": [940, 500]},
      {"id": "td3", "type": "TD3", "name": "TD3", "pos": [1160, 300]}
    ],
    "links": [
      {"from": "env", "to": "p1"},
      {"from": "p1", "to": "pa1"},
      {"from": "pa1", "to": "p2"},
      {"from": "p2", "to": "pa2"},
      {"from": "pa2", "to": "phead"},
      {"from": "env", "to": "q1"},
      {"from": "q1", "to": "qa1"},
      {"from": "qa1", "to": "q2"},
      {"from": "q2", "to": "qa2"},
      {"from": "qa2", "to": "qhead"},
      {"from": "phead", "to": "td3", "to_pin": 0},
      {"from": "env", "from_pin": 1, "to": "td3", "to_pin": 1},
      {"from": "qhead", "to": "td3", "to_pin": 2}
    ]
  }
}
