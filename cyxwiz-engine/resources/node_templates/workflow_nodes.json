      "outputs": [
        {"name": "Data", "type": "Dataset", "description": "Unchanged data after wait"}
      ],
      "parameters": [
        {"name": "duration_ms", "type": "int", "default": "1000", "description": "Wait duration in milliseconds"}
      ],
      "implementation_notes": "Simple sleep in execution thread",
      "target_phase": "Phase 2",
      "dependencies": [],
      "effort_estimate": "Low",
