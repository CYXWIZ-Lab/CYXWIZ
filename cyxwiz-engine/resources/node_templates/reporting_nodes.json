  "templates": [
    {
      "type": "PDFReportWriter",
      "name": "PDF Report Writer",
      "icon": "file-pdf",
      "status": "template",
      "badge": "Coming Soon",
      "keywords": ["pdf", "report", "export", "document"],
      "brief_description": "Export report to PDF",
      "help_text": "Generates a PDF report from data and visualizations. Supports templates and custom layouts.",
      "inputs": [
        {"name": "Data", "type": "Dataset", "required": true, "description": "Data to include in report"},
        {"name": "Charts", "type": "Dataset", "required": false, "description": "Chart images to embed"}
      ],
      "outputs": [
        {"name": "Status", "type": "Dataset", "description": "Export status and file path"}
      ],
      "parameters": [
        {"name": "output_path", "type": "file", "default": "report.pdf", "description": "Output PDF file path"},
        {"name": "title", "type": "string", "default": "Data Report", "description": "Report title"},
        {"name": "template", "type": "enum", "default": "default", "description": "Report template", "enum_values": ["default", "minimal", "detailed"]}
      ],
      "implementation_notes": "Use libharu or PDFium",
      "target_phase": "Phase 3",
      "dependencies": ["libharu"],
      "effort_estimate": "High",
      "user_votes": 0
    },
    {
      "type": "HTMLReportWriter",
