        {"name": "username", "type": "string", "default": "", "description": "SMTP username"},
        {"name": "password", "type": "string", "default": "", "description": "SMTP password"},
        {"name": "to", "type": "string", "default": "", "description": "Recipient email"},
        {"name": "subject", "type": "string", "default": "", "description": "Email subject"},
        {"name": "body", "type": "string", "default": "", "description": "Email body"}
      ],
      "implementation_notes": "Use libcurl with SMTP",
      "target_phase": "Phase 3",
      "dependencies": ["libcurl"],
      "effort_estimate": "Medium",
      "user_votes": 0
    },
