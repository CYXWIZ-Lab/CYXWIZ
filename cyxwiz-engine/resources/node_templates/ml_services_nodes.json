        {"name": "project", "type": "string", "default": "", "description": "Project name"},
        {"name": "entity", "type": "string", "default": "", "description": "Team/user entity"}
      ],
      "implementation_notes": "Use W&B REST API",
      "target_phase": "Phase 3",
      "dependencies": ["libcurl"],
      "effort_estimate": "Medium",
      "user_votes": 0
    },
    {
      "type": "SHAPExplainer",
      "name": "SHAP Explainer",
      "icon": "lightbulb",
      "status": "template",
      "badge": "Coming Soon",
      "keywords": ["shap", "explainability", "feature", "importance"],
      "brief_description": "SHAP feature importance analysis",
      "help_text": "Computes SHAP values for model explainability. Shows feature contributions to predictions.",
      "inputs": [
        {"name": "Model", "type": "Parameters", "required": true, "description": "Trained model"},
        {"name": "Data", "type": "Dataset", "required": true, "description": "Data to explain"}
      ],
      "outputs": [
        {"name": "SHAPValues", "type": "Dataset", "description": "SHAP values for each feature"},
        {"name": "Summary", "type": "Dataset", "description": "Feature importance summary"}
      ],
      "parameters": [
        {"name": "explainer_type", "type": "enum", "default": "tree", "description": "Explainer type", "enum_values": ["tree", "kernel", "deep"]},
        {"name": "max_samples", "type": "int", "default": "100", "description": "Max samples to explain", "validation": "1-100000"}
      ],
      "implementation_notes": "Use Python bridge to SHAP library",
      "target_phase": "Phase 4",
      "dependencies": ["pybind11", "shap"],
      "effort_estimate": "High",
      "user_votes": 0
    },
    {
      "type": "AutoMLNode",
      "name": "AutoML",
      "icon": "wand-magic-sparkles",
      "status": "template",
      "badge": "Coming Soon",
      "keywords": ["automl", "automatic", "hyperparameter", "tuning"],
      "brief_description": "Automatic model selection and tuning",
      "help_text": "Automatically selects the best model and hyperparameters for your data.",
      "inputs": [
        {"name": "X", "type": "Dataset", "required": true, "description": "Features"},
        {"name": "y", "type": "Labels", "required": true, "description": "Target"}
      ],
      "outputs": [
        {"name": "BestModel", "type": "Parameters", "description": "Best model found"},
        {"name": "Results", "type": "Dataset", "description": "All model results"}
      ],
      "parameters": [
        {"name": "task", "type": "enum", "default": "classification", "description": "Task type", "enum_values": ["classification", "regression"]},
        {"name": "time_limit", "type": "int", "default": "300", "description": "Time limit in seconds", "validation": "1-86400"},
        {"name": "metric", "type": "enum", "default": "accuracy", "description": "Optimization metric", "enum_values": ["accuracy", "f1", "roc_auc", "mse", "r2"]}
      ],
      "implementation_notes": "Implement grid/random search or use auto-sklearn",
      "target_phase": "Phase 4",
      "dependencies": [],
      "effort_estimate": "High",
      "user_votes": 0
    }
  ]
