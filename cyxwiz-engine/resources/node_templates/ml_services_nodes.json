{
  "category": "ML Services",
  "category_icon": "brain",
  "description": "External ML services and experiment tracking",
  "templates": [
    {
      "type": "OpenAIEmbeddings",
      "name": "OpenAI Embeddings",
      "icon": "brain",
      "status": "template",
      "badge": "Coming Soon",
      "keywords": ["openai", "embeddings", "text", "vector"],
      "brief_description": "Generate embeddings with OpenAI API",
      "help_text": "Converts text to vector embeddings using OpenAI's embedding models (text-embedding-ada-002).",
      "inputs": [
        {"name": "Text", "type": "Dataset", "required": true, "description": "Text column to embed"}
      ],
      "outputs": [
        {"name": "Embeddings", "type": "Dataset", "description": "Vector embeddings"}
      ],
      "parameters": [
        {"name": "api_key", "type": "password", "default": "", "description": "OpenAI API key"},
        {"name": "model", "type": "enum", "default": "text-embedding-ada-002", "description": "Embedding model", "enum_values": ["text-embedding-ada-002", "text-embedding-3-small", "text-embedding-3-large"]},
        {"name": "batch_size", "type": "int", "default": "100", "description": "Batch size for API calls", "validation": "1-10000"}
      ],
      "implementation_notes": "Use REST API with libcurl",
      "target_phase": "Phase 2",
      "dependencies": ["libcurl", "nlohmann-json"],
      "effort_estimate": "Low",
      "user_votes": 0
    },
    {
      "type": "HuggingFaceHub",
      "name": "HuggingFace Hub",
      "icon": "download",
      "status": "template",
      "badge": "Coming Soon",
      "keywords": ["huggingface", "model", "download", "hub"],
      "brief_description": "Download models from HuggingFace Hub",
      "help_text": "Downloads pre-trained models from HuggingFace Hub for local inference.",
      "inputs": [],
      "outputs": [
        {"name": "Model", "type": "Parameters", "description": "Downloaded model"}
      ],
      "parameters": [
        {"name": "model_id", "type": "string", "default": "", "description": "Model ID (e.g., bert-base-uncased)"},
        {"name": "revision", "type": "string", "default": "main", "description": "Model revision/branch"},
        {"name": "cache_dir", "type": "directory", "default": "", "description": "Local cache directory"}
      ],
      "implementation_notes": "Use HuggingFace Hub API",
      "target_phase": "Phase 3",
      "dependencies": ["libcurl"],
      "effort_estimate": "Medium",
      "user_votes": 0
    },
    {
      "type": "MLflowTracker",
      "name": "MLflow Tracker",
      "icon": "chart-line",
      "status": "template",
      "badge": "Coming Soon",
      "keywords": ["mlflow", "experiment", "tracking", "logging"],
      "brief_description": "Log experiments to MLflow",
      "help_text": "Logs metrics, parameters, and artifacts to an MLflow tracking server.",
      "inputs": [
        {"name": "Metrics", "type": "Dataset", "required": false, "description": "Metrics to log"},
        {"name": "Model", "type": "Parameters", "required": false, "description": "Model to log as artifact"}
      ],
      "outputs": [
        {"name": "RunID", "type": "Dataset", "description": "MLflow run ID"}
      ],
      "parameters": [
        {"name": "tracking_uri", "type": "string", "default": "http://localhost:5000", "description": "MLflow tracking server URI"},
        {"name": "experiment_name", "type": "string", "default": "Default", "description": "Experiment name"},
        {"name": "run_name", "type": "string", "default": "", "description": "Run name (optional)"}
      ],
      "implementation_notes": "Use MLflow REST API",
      "target_phase": "Phase 2",
      "dependencies": ["libcurl"],
      "effort_estimate": "Medium",
      "user_votes": 0
    },
    {
      "type": "WandBTracker",
      "name": "Weights & Biases",
      "icon": "chart-line",
      "status": "template",
      "badge": "Coming Soon",
      "keywords": ["wandb", "weights", "biases", "experiment", "tracking"],
      "brief_description": "Log experiments to W&B",
      "help_text": "Logs metrics, hyperparameters, and artifacts to Weights & Biases.",
      "inputs": [
        {"name": "Metrics", "type": "Dataset", "required": false, "description": "Metrics to log"},
