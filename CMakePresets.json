{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "default",
      "generator": "Visual Studio 18 2026",
      "displayName": "Windows Debug",
      "description": "Debug build for Windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-release",
      "inherits": "default",
      "generator": "Visual Studio 18 2026",
      "displayName": "Windows Release",
      "description": "Release build for Windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "default",
      "generator": "Ninja",
      "displayName": "Linux Debug",
      "description": "Debug build for Linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "inherits": "default",
      "generator": "Ninja",
      "displayName": "Linux Release",
      "description": "Release build for Linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "default",
      "generator": "Ninja",
      "displayName": "macOS Debug",
      "description": "Debug build for macOS",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-release",
      "inherits": "default",
      "generator": "Ninja",
      "displayName": "macOS Release",
      "description": "Release build for macOS",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "gpu-providers",
      "hidden": true,
      "description": "Asks for every optional neural provider. A provider whose toolkit is missing warns and is left out; the configure prints the provider table.",
      "cacheVariables": {
        "CYXWIZ_ENABLE_CUDA": "ON",
        "CYXWIZ_ENABLE_OPENCL": "ON",
        "CYXWIZ_ENABLE_NVIDIA_DNN_PROVIDER": "ON",
        "CYXWIZ_ENABLE_OPENCL_DNN_PROVIDER": "ON",
        "CYXWIZ_ENABLE_ONEAPI_DNN_PROVIDER": "ON"
      }
    },
    {
      "name": "gpu-dev",
      "inherits": [
        "default",
        "gpu-providers"
      ],
      "binaryDir": "${sourceDir}/build-gpu-dev",
      "generator": "Visual Studio 18 2026",
      "displayName": "GPU developer build (Windows)",
      "description": "Release build with every neural provider whose toolkit is present (CUDA Toolkit, OpenCL SDK, oneAPI DPC++): the build that matches the GPU packs. Use it for GPU tests, gates and benchmarks.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-gpu-dev",
      "inherits": [
        "default",
        "gpu-providers"
      ],
      "binaryDir": "${sourceDir}/build-gpu-dev",
      "generator": "Ninja",
      "displayName": "GPU developer build (Linux)",
      "description": "Release build with every neural provider whose toolkit is present (CUDA Toolkit, OpenCL SDK, oneAPI DPC++).",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "gpu-dev",
      "configurePreset": "gpu-dev",
      "configuration": "Release"
    },
    {
      "name": "linux-gpu-dev",
      "configurePreset": "linux-gpu-dev"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
