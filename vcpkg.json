{
  "name": "cyxwiz",
  "version": "0.1.0",
  "description": "CyxWiz visual machine-learning and data workflow platform",
  "dependencies": [
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "glfw-binding",
        "opengl3-binding"
      ]
    },
    "implot",
    "glfw3",
    "glad",
    "stb",
    "grpc",
    "protobuf",
    "spdlog",
    "nlohmann-json",
    "fmt",
    "sqlite3",
    "openssl",
    {
      "name": "libarchive",
      "default-features": false
    },
    "pybind11",
    "catch2",
    "highfive",
    {
      "name": "opencv4",
      "default-features": true,
      "platform": "!android"
    },
    "ftxui",
    "cpp-httplib",
    "yaml-cpp",
    "jwt-cpp",
    "onnx",
    "llama-cpp",
    {
      "name": "onnxruntime",
      "platform": "!osx"
    },
    "nativefiledialog-extended",
    "libvterm",
    "duckdb",
    "openxlsx",
    "libsndfile",
    "fftw3",
    {
      "name": "arrow",
      "features": ["parquet", "csv", "json"]
    }
  ],
  "features": {
    "html-parser": {
      "description": "Optional Lexbor provider for parsed HTML in Text Clean.",
      "dependencies": ["lexbor"]
    },
    "sentencepiece": {
      "description": "Optional official SentencePiece C++ tokenizer provider for TextTokenizer SentencePiece BPE/Unigram families.",
      "dependencies": [
        "sentencepiece"
      ]
    }
  },
  "builtin-baseline": "594ad8871e1e8e45f8e626c015fd611163430207"
}
